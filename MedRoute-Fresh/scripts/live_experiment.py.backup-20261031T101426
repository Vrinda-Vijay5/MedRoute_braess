def save_json(path, value):
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def diagnostic_command(args):
    """Capture read-only host state when a live run fails."""
    try:
        proc = subprocess.run(args, cwd=ROOT, capture_output=True, text=True, timeout=4)
        return {"returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}
    except Exception as exc:
        return {"error": type(exc).__name__ + ": " + str(exc)}


def request_json(method="GET", value=None, timeout=1, endpoint=API):
    data = None if value is None else json.dumps(value).encode("utf-8")
    req = urllib.request.Request(endpoint, data=data, method=method,
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def wait_controller(process, timeout=25):
    deadline = time.monotonic() + timeout
    last = "not ready"
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise RuntimeError("Ryu exited during startup")
        try:
            state = request_json(timeout=1)
            if state.get("mode") == "baseline":
                return state
        except urllib.error.HTTPError as exc:
            if exc.code >= 500:
                raise RuntimeError("controller readiness returned HTTP {}".format(exc.code)) from exc
            last = str(exc)
        except Exception as exc:  # readiness polling only
            last = str(exc)
        time.sleep(.25)
    raise TimeoutError("Ryu REST API readiness timeout: " + last)


def wait_switches(timeout=20):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        state = request_json(timeout=1)
        if state.get("active_dpids") == EXPECTED_DPIDS:
            return state
        time.sleep(.25)
    raise TimeoutError("expected four connected OVS switches; last state=" + repr(state))


def set_mode(mode, reason):
    try:
        result = request_json("POST", {"mode": mode, "reason": reason}, timeout=6)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", body)
        except (json.JSONDecodeError, AttributeError):
            detail = body or str(exc)
        raise RuntimeError("controller route update failed: {}".format(detail)) from exc
    if result.get("switch_barrier_confirmed") is not True:
        raise RuntimeError("controller returned without confirming all route barriers")
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        current = request_json(timeout=1)
        if (current.get("mode") == mode and current.get("active_dpids") == EXPECTED_DPIDS and
                current.get("route_installation_confirmed") is True):
            return result
        time.sleep(.1)
    raise TimeoutError("controller did not report mode " + mode)


def set_qos_enabled(enabled):
    try:
        result = request_json("POST", {"enabled": enabled}, timeout=6, endpoint=QOS_API)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        try:
            detail = json.loads(body).get("error", body)
        except (json.JSONDecodeError, AttributeError):
            detail = body or str(exc)
        raise RuntimeError("controller QoS update failed: {}".format(detail)) from exc
    if result.get("switch_barrier_confirmed") is not True:
        raise RuntimeError("controller returned without confirming all QoS barriers")
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        state = request_json(timeout=1, endpoint=QOS_API)
        if (state.get("qos_enabled") is enabled and
                state.get("active_dpids") == EXPECTED_DPIDS and
                state.get("qos_state_confirmed") is True):
            return result
        time.sleep(.1)
    raise TimeoutError("controller did not report QoS enabled=" + str(enabled))


def resolve_method_plan(method_id=None):
    """Return the runner scenario plan appropriate for the selected method."""
    if method_id is None:
        return SCENARIO_PLAN
    return build_method_scenario_plan(method_id)


def method_qos_enabled(method_id=None):
    """Return the QoS state required by the selected method or the legacy default."""
    if method_id is None:
        return True
    return get_method(method_id).qos_enabled


def restore_method_qos_state(method_id=None, set_qos_fn=None, read_qos_fn=None):
    """Ensure QoS matches the selected method and return whether it is verified."""
    desired = method_qos_enabled(method_id)
    if set_qos_fn is not None:
        set_qos_fn(desired)
    if read_qos_fn is not None:
        return bool(read_qos_fn() is desired)
    return desired


def summarize_method_policy(method_id=None):
    """Return method metadata for config and evidence without mutating policy state."""
    if method_id is None:
        return {
            "selected_method": None,
            "method_id": None,
            "name": None,
            "initial_route": None,
            "qos_enabled": None,
            "candidate_evaluation_enabled": None,
            "braess_guard_enabled": None,
            "available_for_research_comparison": None,
            "unavailable_reason": None,
        }
    method = get_method(method_id)
    return {
        "selected_method": method.method_id,
        "method_id": method.method_id,
        "name": method.name,
        "initial_route": method.initial_route,
        "qos_enabled": method.qos_enabled,
        "candidate_evaluation_enabled": method.candidate_evaluation_enabled,
        "braess_guard_enabled": method.braess_guard_enabled,
        "available_for_research_comparison": method.available,
        "unavailable_reason": method.unavailable_reason or None,
    }


def build_catalog_matrix_summary(method_id, profile_matrix):
    """Return the policy-aware catalog-matrix summary used by the live runner."""
    if method_id == "M1":
        return {
            "profiles": 0,
            "complete": False,
            "file": None,
            "skipped": True,
            "status": "not_applicable",
        }
    return {
        "profiles": len(profile_matrix),
        "complete": bool(profile_matrix) and all(row.get("complete") for row in profile_matrix),
        "file": "profile_matrix.json" if profile_matrix else None,
        "skipped": False,
        "status": "complete" if profile_matrix else "not_run",
    }


def catalog_matrix_validation(method_id, profile_matrix):
    """Return summary plus validation errors for the catalog matrix by the chosen method."""
    summary = build_catalog_matrix_summary(method_id, profile_matrix)
    if method_id == "M1":
        return summary, []
    errors = [
        "catalog profile {} has incomplete live execution or forwarding evidence".format(
            row.get("profile"))
        for row in profile_matrix if not row.get("complete")
    ]
    return summary, errors


def combine_validation_errors(existing_errors, matrix_errors=None):
    """Return a combined validation list while keeping intentional M1-matrix skips separate."""
    combined = list(existing_errors or [])
    if matrix_errors:
        combined.extend(matrix_errors)
    return combined


def braess_validation_result(method_id=None, braess_repetitions=None):
    """Return policy-aware Braess validation semantics for default vs explicit methods."""
    repetitions = [] if braess_repetitions is None else braess_repetitions
    if method_id is not None and method_id in {"M1", "M2", "M3"}:
        return {"status": "not_run", "passed": False, "not_applicable": True}
    if not repetitions:
        return {"status": "not_run", "passed": False, "not_applicable": True}
    passed = all(
        row.get("complete") and row.get("decision", {}).get("controller_recorded") and
        row.get("decision", {}).get("route_selection_verified") and
        (row.get("decision", {}).get("verdict") != "harmful" or
         row.get("decision", {}).get("prevention_verified"))
        for row in repetitions)
    return {"status": "passed" if passed else "failed", "passed": bool(passed), "not_applicable": False}


def compute_exit_code(passed, scenario_validation, selected_method=None, final_qos_verified=None):
    """Return the runner exit code while keeping legacy behavior for default mode."""
    baseline_result = 0 if passed and scenario_validation else 2
    if selected_method is None:
        return baseline_result
    if final_qos_verified is False:
        return 2
    return baseline_result


def verify_flows(stage, mode, evidence_dir, routes, class_config):
    expected = next(row for row in routes[mode] if row[0] == 2 and row[3] == "10.0.0.1")
    marker = "in_port=" + str(expected[1])
    action = "output:" + str(expected[2])
    queue_ids = sorted(profile["queue_id"] for profile in class_config["classes"].values())
    qos_enabled = request_json(timeout=2, endpoint=QOS_API).get("qos_enabled")
    deadline = time.monotonic() + 5
    captured, error = [], ""
    while time.monotonic() < deadline:
        captured = []
        error = ""
        for switch in ("s1", "s2", "s3", "s4"):
            proc = subprocess.run(["ovs-ofctl", "-O", "OpenFlow13", "dump-flows", switch],
                cwd=ROOT, capture_output=True, text=True, timeout=8)
            if proc.returncode:
                error = "ovs-ofctl failed for " + switch + ": " + proc.stderr
                break
            captured.append("### " + switch + "\n" + proc.stdout)
        lines = [line for block in captured for line in block.splitlines()]
        route_ok = len(captured) == 4 and any(marker in line and action in line
                                               for line in captured[1].splitlines())
        seen_queues = {int(value) for line in lines
                       for value in re.findall(r"set_queue:(\d+)", line)}
        queue_actions_ok = (set(queue_ids).issubset(seen_queues) if qos_enabled else not seen_queues)
        if route_ok and queue_actions_ok:
            break
        time.sleep(.2)
    text = "\n".join(captured)
    (evidence_dir / ("flows_" + stage + ".txt")).write_text(text, encoding="utf-8")
    if error:
        raise RuntimeError(error)
    if len(captured) != 4 or not any(marker in line and action in line for line in captured[1].splitlines()):
        raise RuntimeError("installed OpenFlow evidence does not show expected s2 route " + mode)
    if qos_enabled and not set(queue_ids).issubset(seen_queues):
        raise RuntimeError("installed OpenFlow evidence is missing configured QoS queues: " +
                           repr(sorted(set(queue_ids) - seen_queues)))
    if not qos_enabled and seen_queues:
        raise RuntimeError("QoS-disabled scenario still has queue actions: " + repr(sorted(seen_queues)))
    qos_evidence = ["### HTB attachments"]
    attached = 0
    for switch in ("s1", "s2", "s3", "s4"):
        ports = subprocess.run(["ovs-vsctl", "list-ports", switch], cwd=ROOT,
                               capture_output=True, text=True, timeout=8, check=True).stdout.splitlines()
        for port in (value.strip() for value in ports if value.strip()):
            qos_id = subprocess.run(["ovs-vsctl", "get", "Port", port, "qos"], cwd=ROOT,
                                    capture_output=True, text=True, timeout=8, check=True).stdout.strip()
            if not qos_id or qos_id == "[]":
                raise RuntimeError("QoS is not attached to OVS port " + port)
            qos_type = subprocess.run(["ovs-vsctl", "get", "QoS", qos_id, "type"], cwd=ROOT,
                                      capture_output=True, text=True, timeout=8, check=True).stdout.strip().strip('"')
            queues = subprocess.run(["ovs-vsctl", "get", "QoS", qos_id, "queues"], cwd=ROOT,
                                    capture_output=True, text=True, timeout=8, check=True).stdout
            attached_ids = {int(value) for value in re.findall(r"(?:^|[, {])(\d+)\s*=", queues)}
            if qos_type != "linux-htb" or not set(queue_ids).issubset(attached_ids):
                raise RuntimeError("HTB queue set is incomplete on OVS port " + port)
            qos_evidence.append("{} qos={} type={} queues={}".format(port, qos_id, qos_type,
                                                                        sorted(attached_ids)))
            attached += 1
    text += "\n" + "\n".join(qos_evidence) + "\n"
    (evidence_dir / ("flows_" + stage + ".txt")).write_text(text, encoding="utf-8")
    return {"mode": mode, "s2_h1_egress": expected[2], "verified": True,
            "qos_enabled": qos_enabled, "queue_actions_verified": queue_actions_ok,
            "queue_ids_seen": sorted(seen_queues),
            "htb_ports_verified": attached}


def configure_scenario_bottleneck(enabled, class_config):
    """Shape S1's S2-facing egress only during the two congestion scenarios."""
    capacity = (SCENARIO_BOTTLENECK_CAPACITY_MBPS if enabled
                else class_config["link_capacity_mbps"])
    override = capacity if capacity < class_config["link_capacity_mbps"] else None
    command = queue_command(SCENARIO_BOTTLENECK_PORT, class_config, override)
    proc = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=12)
    if proc.returncode:
        raise RuntimeError("failed to configure scenario HTB bottleneck: " + proc.stderr)
    qos_id = subprocess.run(["ovs-vsctl", "get", "Port", SCENARIO_BOTTLENECK_PORT, "qos"],
        cwd=ROOT, capture_output=True, text=True, timeout=8, check=True).stdout.strip()
    raw_rate = subprocess.run(["ovs-vsctl", "get", "QoS", qos_id, "other-config:max-rate"],
        cwd=ROOT, capture_output=True, text=True, timeout=8, check=True).stdout
    match = re.search(r"\d+", raw_rate)
    observed_capacity = int(match.group(0)) / 1_000_000 if match else None
    if observed_capacity != capacity:
        raise RuntimeError("scenario bottleneck rate mismatch: expected {} Mbps, observed {}".format(
            capacity, observed_capacity))
    return {"port": SCENARIO_BOTTLENECK_PORT,
            "capacity_mbps": capacity, "verified": True}


def parse_scenario_flow_usage(flow_dump, class_config, qos_enabled):
    """Confirm each scenario UDP service packet hit its class rule and queue."""
    classes = {}
    for name, profile in class_config["classes"].items():
        packets = byte_count = 0
        observed_queues = set()
        for line in flow_dump.splitlines():
            if ("udp," not in line or "nw_src=10.0.0.1" not in line or
                    "nw_dst=10.0.0.2" not in line or
                    not re.search(r"(?:^|,)tp_dst={}(?:,|\s)".format(profile["udp_port"]), line)):
                continue
            packet_match = re.search(r"n_packets=(\d+)", line)
            byte_match = re.search(r"n_bytes=(\d+)", line)
            if packet_match:
                packets += int(packet_match.group(1))
            if byte_match:
                byte_count += int(byte_match.group(1))
            observed_queues.update(int(value) for value in
                                   re.findall(r"set_queue:(\d+)", line))
        expected_queue = profile["queue_id"] if qos_enabled else None
        queue_match = (expected_queue in observed_queues if qos_enabled
                       else not observed_queues)
        classes[name] = {"packets": packets, "bytes": byte_count,
                         "expected_queue_id": expected_queue,
                         "observed_queue_ids": sorted(observed_queues),
                         "complete": packets > 0 and queue_match}
    return {"classes": classes,
            "complete": all(item["complete"] for item in classes.values())}


def collect_scenario_flow_usage(scenario, repetition, evidence_dir,
                                class_config, qos_enabled):
    proc = subprocess.run(["ovs-ofctl", "-O", "OpenFlow13", "dump-flows", "s1"],
                          cwd=ROOT, capture_output=True, text=True, timeout=8)
    if proc.returncode:
        raise RuntimeError("post-traffic OpenFlow stats failed for s1: " + proc.stderr)
    (evidence_dir / ("flows_traffic_{}_r{}.txt".format(scenario, repetition))) \
        .write_text(proc.stdout, encoding="utf-8")
    return parse_scenario_flow_usage(proc.stdout, class_config, qos_enabled)


def ping_sample(host, tos=None):
    started = time.time()
    command = ["ping", "-n", "-c", "1", "-W", "2"]
    if tos is not None:
        command.extend(["-Q", str(tos)])
    command.append("10.0.0.2")
    proc = host.popen(command,
                      stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    try:
        output, _ = proc.communicate(timeout=4)
    except subprocess.TimeoutExpired:
        proc.kill()
        output, _ = proc.communicate()
    match = re.search(r"time[=<]([0-9.]+)\s*ms", output)
    rtt = float(match.group(1)) if proc.returncode == 0 and match else None
    return {"timestamp": started, "rtt_ms": rtt, "returncode": proc.returncode,
            "output": output.strip()}


def summarize_samples(samples, expected_samples=SAMPLES):
    """Summarize probes: median RTT, median adjacent RTT delta, and loss %.

    Jitter uses adjacent successful probe pairs. At least three replies and two
    adjacent pairs are required; observed loss remains part of the composite.
    """
    if not isinstance(expected_samples, int) or expected_samples <= 0 or len(samples) != expected_samples:
        return None
    for sample in samples:
        if not isinstance(sample, dict) or "rtt_ms" not in sample or "timestamp" not in sample:
            return None
        rtt, stamp = sample.get("rtt_ms"), sample.get("timestamp")
        if not isinstance(stamp, (int, float)) or not math.isfinite(stamp):
            return None
        if rtt is not None and (not isinstance(rtt, (int, float)) or not math.isfinite(rtt) or rtt < 0):
            return None
    values = [s["rtt_ms"] for s in samples if s["rtt_ms"] is not None]
    loss = 100.0 * (expected_samples - len(values)) / expected_samples
    if len(values) < 3:
        return {"complete": False, "latency_ms": None, "jitter_ms": None, "packet_loss_pct": loss, "cost": None}
    latency = statistics.median(values)
    adjacent = [abs(samples[i]["rtt_ms"] - samples[i-1]["rtt_ms"])
                for i in range(1, len(samples))
                if samples[i]["rtt_ms"] is not None and samples[i-1]["rtt_ms"] is not None]
    if len(adjacent) < 2:
        return {"complete": False, "latency_ms": latency, "jitter_ms": None, "packet_loss_pct": loss, "cost": None}
    jitter = statistics.median(adjacent)
    cost = (latency / COST_REFERENCES["latency_ms"] + jitter / COST_REFERENCES["jitter_ms"] +
            loss / COST_REFERENCES["packet_loss_pct"]) / 3.0
    return {"complete": True, "latency_ms": latency, "jitter_ms": jitter,
            "packet_loss_pct": loss, "cost": cost}


PORT_PEERS = {
    ("s1", 1): "h1", ("s1", 2): "s2-eth1", ("s1", 3): "s3-eth1",
    ("s1", 6): "h3", ("s1", 7): "h4",
    ("s2", 1): "s1-eth2", ("s2", 2): "s4-eth1", ("s2", 3): "s3-eth3",
    ("s3", 1): "s1-eth3", ("s3", 2): "s4-eth2", ("s3", 3): "s2-eth3",
    ("s4", 1): "s2-eth2", ("s4", 2): "s3-eth2", ("s4", 3): "h2",
    ("s4", 4): "h5", ("s4", 5): "h6",
}


def parse_port_stats(output):
    """Parse OpenFlow ovs-ofctl dump-ports counters without filling gaps."""
    ports = {}
    current = None
    for line in output.splitlines():
        header = re.search(r"\bport\s+(\d+):", line)
        if header:
            current = int(header.group(1))
            ports[current] = {}
        if current is None:
            continue
        byte_count = re.search(r"bytes=(\d+)", line)
        if byte_count and re.search(r"\brx\s+pkts=", line):
            ports[current]["rx_bytes"] = int(byte_count.group(1))
        if byte_count and re.search(r"\btx\s+pkts=", line):
            ports[current]["tx_bytes"] = int(byte_count.group(1))
    return {port: counters for port, counters in ports.items()
            if "rx_bytes" in counters and "tx_bytes" in counters}


def collect_port_snapshot():
    snapshot = {}
    for switch in ("s1", "s2", "s3", "s4"):
        proc = subprocess.run(["ovs-ofctl", "-O", "OpenFlow13", "dump-ports", switch],
                              cwd=ROOT, capture_output=True, text=True, timeout=8)
        if proc.returncode:
            raise RuntimeError("OpenFlow port stats failed for {}: {}".format(switch, proc.stderr))
        snapshot[switch] = parse_port_stats(proc.stdout)
    return {"timestamp": time.time(), "switches": snapshot}


def calculate_link_utilization(before, after, capacity_mbps, capacity_overrides=None):
    """Calculate directional Mbps/utilization from two real port-stat snapshots."""
    interval = after["timestamp"] - before["timestamp"]
    capacity_overrides = capacity_overrides or {}
    links, complete = [], interval > 0
    for (switch, port), peer in PORT_PEERS.items():
        link_capacity = capacity_overrides.get((switch, port), capacity_mbps)
        old = before["switches"].get(switch, {}).get(port)
        new = after["switches"].get(switch, {}).get(port)
        valid = (old is not None and new is not None and interval > 0 and
                 new["rx_bytes"] >= old["rx_bytes"] and new["tx_bytes"] >= old["tx_bytes"])
        if valid:
            rx_mbps = 8 * (new["rx_bytes"] - old["rx_bytes"]) / interval / 1_000_000
            tx_mbps = 8 * (new["tx_bytes"] - old["tx_bytes"]) / interval / 1_000_000
            rx_pct, tx_pct = rx_mbps / link_capacity * 100, tx_mbps / link_capacity * 100
        else:
            rx_mbps = tx_mbps = rx_pct = tx_pct = None
            complete = False
        links.append({"name": "{}-eth{} <-> {}".format(switch, port, peer),
                      "switch": switch, "port": port, "peer": peer,
                      "capacity_mbps": link_capacity,
                      "rx_mbps": rx_mbps, "tx_mbps": tx_mbps,
                      "rx_utilization_pct": rx_pct, "tx_utilization_pct": tx_pct,
                      "complete": valid})
    return {"complete": complete, "interval_seconds": interval if interval > 0 else None,
            "capacity_mbps": capacity_mbps, "links": links}


def parse_tc_queue_occupancy(output):
    """Parse Linux tc class backlog bytes/packets without guessing queue IDs."""
    records = []
    current = None
    for line in output.splitlines():
        class_match = re.search(r"\bclass\s+\S+\s+([0-9a-fA-F]+:[0-9a-fA-F]+)", line)
        if class_match:
            current = {"class_id": class_match.group(1)}
            records.append(current)
        backlog = re.search(r"\bbacklog\s+(\d+)b\s+(\d+)p", line)
        if backlog and current is not None:
            current["backlog_bytes"] = int(backlog.group(1))
            current["backlog_packets"] = int(backlog.group(2))
    complete = bool(records) and all("backlog_bytes" in row and
                                     "backlog_packets" in row for row in records)
    return {"complete": complete, "classes": records,
            "reason": None if complete else "tc did not expose per-class backlog counters"}


def collect_queue_occupancy(port_name):
    try:
        proc = subprocess.run(["tc", "-s", "class", "show", "dev", port_name],
                              cwd=ROOT, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as exc:
        return {"complete": False, "port": port_name, "classes": [],
                "reason": type(exc).__name__ + ": " + str(exc)}
    parsed = parse_tc_queue_occupancy(proc.stdout)
    parsed["port"] = port_name
    parsed["command_returncode"] = proc.returncode
    if proc.returncode:
        parsed["complete"] = False
        parsed["reason"] = proc.stderr.strip() or "tc command failed"
    parsed["raw"] = proc.stdout
    return parsed


def summarize_queue_occupancy(before, after):
    before_rows = {row["class_id"]: row for row in before.get("classes", [])}
    after_rows = {row["class_id"]: row for row in after.get("classes", [])}
    common = sorted(set(before_rows) & set(after_rows))
    complete = bool(common) and before.get("complete") and after.get("complete")
    return {"complete": bool(complete), "port": after.get("port"),
            "class_count": len(common),
            "classes": [{"class_id": class_id,
                "before_backlog_bytes": before_rows[class_id]["backlog_bytes"],
                "after_backlog_bytes": after_rows[class_id]["backlog_bytes"],
                "peak_observed_backlog_bytes": max(before_rows[class_id]["backlog_bytes"],
                                                    after_rows[class_id]["backlog_bytes"]),
                "before_backlog_packets": before_rows[class_id]["backlog_packets"],
                "after_backlog_packets": after_rows[class_id]["backlog_packets"]}
                for class_id in common],
            "reason": None if complete else "per-class queue counters unavailable or class set changed"}


def sample_class_traffic(net, traffic_class, profile):
    """Run a real TCP class flow alongside DSCP-marked ICMP probes."""
    h1, h2 = net.get("h1", "h2")
    port, tos = profile["tcp_port"], profile["dscp"] << 2
    started = time.time()
    server = h2.popen(["iperf3", "-s", "-1", "-p", str(port)],
                      stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    time.sleep(.3)
    if server.poll() is not None:
        return {"traffic_class": traffic_class, "queue_id": profile["queue_id"],
                "dscp": profile["dscp"], "service_port": port, "complete": False,
                "metrics": None, "throughput_mbps": None, "samples": [],
                "timestamp": time.time(), "error": "iperf3 class server failed to start"}

    client = None
    samples = []
    client_output = ""
    error = None
    try:
        client = h1.popen(["iperf3", "-c", "10.0.0.2", "-p", str(port),
                           "-t", "4", "-J", "-S", str(tos)],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for _ in range(SAMPLES):
            samples.append(ping_sample(h1, tos=tos))
            time.sleep(.15)
        try:
            client_output, _ = client.communicate(timeout=8)
        except subprocess.TimeoutExpired:
            client.terminate()
            client_output, _ = client.communicate(timeout=2)
            error = "iperf3 class client timed out"
        try:
            server.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            server.terminate()
            server.communicate(timeout=2)
    except Exception as exc:
        error = type(exc).__name__ + ": " + str(exc)
    finally:
        for proc in (client, server):
            if proc is not None and proc.poll() is None:
                proc.terminate()
                try:
                    proc.communicate(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.communicate()

    metrics = summarize_samples(samples) if len(samples) == SAMPLES else None
    throughput_bps = None
    if client is not None and client.returncode == 0:
        try:
            result = json.loads(client_output)
            throughput_bps = result.get("end", {}).get("sum_received", {}).get("bits_per_second")
            if throughput_bps is None:
                throughput_bps = result.get("end", {}).get("sum_sent", {}).get("bits_per_second")
            if not isinstance(throughput_bps, (int, float)) or throughput_bps <= 0:
                throughput_bps = None
        except (json.JSONDecodeError, AttributeError):
            throughput_bps = None
    complete = bool(metrics and metrics["complete"] and throughput_bps is not None and error is None)
    if not complete and error is None:
        error = "incomplete class telemetry or missing positive throughput"
    return {"traffic_class": traffic_class, "queue_id": profile["queue_id"],
            "dscp": profile["dscp"], "tos": tos, "service_port": port,
            "complete": complete, "metrics": metrics,
            "throughput_mbps": throughput_bps / 1_000_000 if throughput_bps is not None else None,
            "iperf_bits_per_second": throughput_bps, "samples": samples,
            "timestamp": time.time(), "duration_seconds": time.time() - started,
            "error": error}


def collect_class_metrics(net, class_config):
    try:
        before = collect_port_snapshot()
    except Exception as exc:
        before = None
        link_error = type(exc).__name__ + ": " + str(exc)
    else:
        link_error = None
    per_class = {
        name: sample_class_traffic(net, name, profile)
        for name, profile in class_config["classes"].items()
    }
    if before is not None:
        try:
            after = collect_port_snapshot()
            links = calculate_link_utilization(before, after, class_config["link_capacity_mbps"])
        except Exception as exc:
            links = {"complete": False, "interval_seconds": None,
                     "capacity_mbps": class_config["link_capacity_mbps"],
                     "links": [], "error": type(exc).__name__ + ": " + str(exc)}
    else:
        links = {"complete": False, "interval_seconds": None,
                 "capacity_mbps": class_config["link_capacity_mbps"],
                 "links": [], "error": link_error}
    return per_class, links


def sample_stage(net, stage, mode, evidence_dir, routes, class_config):
    set_mode(mode, "stage " + stage)
    flows = verify_flows(stage, mode, evidence_dir, routes, class_config)
    h1, h2 = net.get("h1", "h2")
    server = h2.popen(["iperf3", "-s", "-1"], stdout=subprocess.PIPE,
                      stderr=subprocess.STDOUT, text=True)
    time.sleep(.4)
    if server.poll() is not None:
        raise RuntimeError("iperf3 server failed to start")
    client = None
    samples = []
    client_output, server_output = "", ""
    try:
        client = h1.popen(["iperf3", "-c", "10.0.0.2", "-t", "4", "-J"],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        for _ in range(SAMPLES):
            samples.append(ping_sample(h1))
            time.sleep(.15)
        try:
            client_output, _ = client.communicate(timeout=8)
        except subprocess.TimeoutExpired:
            client.terminate()
            client_output, _ = client.communicate(timeout=2)
        try:
            server_output, _ = server.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            server.terminate()
            server_output, _ = server.communicate(timeout=2)
    finally:
        for proc in (client, server):
            if proc is None:
                continue
            if proc.poll() is None:
                proc.terminate()
                try:
                    output, _ = proc.communicate(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    output, _ = proc.communicate()
                if proc is client and not client_output:
                    client_output = output or ""
                elif proc is server and not server_output:
                    server_output = output or ""
    if client is None or client.returncode != 0 or server.returncode != 0:
        raise RuntimeError("iperf3 traffic generation failed; client=" + str(client.returncode) +
                           " server=" + str(server.returncode))
    try:
        iperf_json = json.loads(client_output)
        throughput = iperf_json.get("end", {}).get("sum_received", {}).get("bits_per_second")
        if throughput is None:
            throughput = iperf_json.get("end", {}).get("sum_sent", {}).get("bits_per_second")
        if not isinstance(throughput, (int, float)) or throughput <= 0:
            raise ValueError("missing positive throughput")
    except (json.JSONDecodeError, ValueError, AttributeError) as exc:
        raise RuntimeError("iperf3 did not provide valid throughput evidence: " + str(exc))
    valid = [s["rtt_ms"] for s in samples if s["rtt_ms"] is not None]
    metrics = summarize_samples(samples)
    per_class_metrics, link_utilization = collect_class_metrics(net, class_config)
    metrics_payload = {"stage": stage, "collected_at": time.time(),
                       "per_class_metrics": per_class_metrics,
                       "link_utilization": link_utilization}
    try:
        published = request_json("POST", metrics_payload, timeout=3,
                                 endpoint=METRICS_API)
        controller_metrics = request_json(timeout=2, endpoint=METRICS_API)
        rest_publication = {"complete": bool(published.get("accepted") and
                                             controller_metrics.get("fresh") and
                                             controller_metrics.get("measurements", {}).get("stage") == stage),
                            "response": published,
                            "route_decision": controller_metrics.get("route_decision")}
        if not rest_publication["complete"]:
            rest_publication["error"] = "controller metrics endpoint returned missing or stale data"
    except Exception as exc:
        rest_publication = {"complete": False,
                            "error": type(exc).__name__ + ": " + str(exc)}
        controller_metrics = None
    result = {"stage": stage, "mode": mode, "samples": samples,
              "sample_count": len(samples), "valid_count": len(valid),
              "metrics": metrics,
              "complete": bool(metrics and metrics.get("complete") and
                               flows.get("verified") and throughput is not None),
              "per_class_metrics": per_class_metrics,
              "link_utilization": link_utilization,
              "controller_metrics": rest_publication,
              "median_rtt_ms": metrics["latency_ms"] if metrics and metrics["complete"] else None,
              "flow_evidence": flows,
              "iperf_bits_per_second": throughput,
              "iperf_client_returncode": client.returncode,
              "iperf_server_returncode": server.returncode,
              "iperf_client_output": client_output, "iperf_server_output": server_output}
    save_json(evidence_dir / ("measurements_" + stage + ".json"), result)
    return result


def measure_route_condition(net, mode, shortcut_link, evidence_dir, routes, class_config):
    """Take a fresh paired-decision sample under the same generated TCP load."""
    set_shortcut_link(shortcut_link, mode == "shortcut")
    set_mode(mode, "paired route comparison")
    flows = verify_flows("decision_" + mode, mode, evidence_dir, routes, class_config)
    h1, h2 = net.get("h1", "h2")
    before_ports = collect_port_snapshot()
    server = h2.popen(["iperf3", "-s", "-1"], stdout=subprocess.PIPE,
                      stderr=subprocess.STDOUT, text=True)
    time.sleep(.3)
    if server.poll() is not None:
        return {"mode": mode, "samples": [], "valid_count": 0,
                "metrics": None, "throughput_mbps": None,
                "flow_evidence": flows, "complete": False,
                "error": "paired iperf3 server failed to start"}
    client = h1.popen(["iperf3", "-c", "10.0.0.2", "-t", "4", "-J"],
                      stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    samples = []
    client_output = ""
    try:
        for _ in range(SAMPLES):
            samples.append(ping_sample(h1))
            time.sleep(.15)
        try:
            client_output, _ = client.communicate(timeout=8)
        except subprocess.TimeoutExpired:
            client.terminate()
            client_output, _ = client.communicate(timeout=2)
        try:
            server.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            server.terminate()
            server.communicate(timeout=2)
    finally:
        for proc in (client, server):
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.communicate(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.communicate()
    throughput = None
    if client.returncode == 0:
        try:
            end = json.loads(client_output).get("end", {})
            bps = end.get("sum_received", {}).get("bits_per_second")
            if bps is None:
                bps = end.get("sum_sent", {}).get("bits_per_second")
            if isinstance(bps, (int, float)) and math.isfinite(bps) and bps > 0:
                throughput = bps / 1_000_000
        except (json.JSONDecodeError, AttributeError):
            pass
    metrics = summarize_samples(samples)
    after_ports = collect_port_snapshot()
    path_utilization = calculate_link_utilization(
        before_ports, after_ports, class_config["link_capacity_mbps"])
    valid_count = sum(sample["rtt_ms"] is not None for sample in samples)
    complete = bool(metrics and metrics["complete"] and throughput is not None and flows["verified"])
    return {"mode": mode, "samples": samples, "valid_count": valid_count,
            "metrics": metrics, "throughput_mbps": throughput,
            "flow_evidence": flows, "path_link_utilization": path_utilization,
            "complete": complete,
            "error": None if complete else "incomplete paired route telemetry"}


def route_congestion_score(route_name, route_rows, utilization):
    """Return max measured egress utilization for a route's forward path."""
    route_ports = {(int(dpid), int(out_port)) for dpid, _, out_port, src, dst in route_rows
                   if src == "10.0.0.1" and dst == "10.0.0.2"}
    link_rows = {(int(row["switch"][1:]), int(row["port"])): row
                 for row in utilization.get("links", [])}
    used = [link_rows.get(key) for key in route_ports]
    if (not route_ports or len(used) != len(route_ports) or
            any(row is None or not row.get("complete") or
                not isinstance(row.get("tx_utilization_pct"), (int, float)) or
                not math.isfinite(row["tx_utilization_pct"]) for row in used)):
        return None
    return max(row["tx_utilization_pct"] for row in used)


def select_congestion_route(measurements, routes):
    """Select the complete path with the lowest observed bottleneck utilization.

    Missing path counters fail closed to baseline. This selector optimizes
    measured path congestion only; it does not classify Braess harm or apply
    CBDR's criticality constraints.
    """
    scores = {}
    for row in measurements:
        name = row.get("mode")
        score = route_congestion_score(name, routes.get(name, []),
                                       row.get("path_link_utilization", {}))
        if not row.get("complete") or score is None:
            return {"selected_route": "baseline", "complete": False,
                    "reason_code": "INCOMPLETE_PATH_UTILIZATION",
                    "scores_pct": scores,
                    "reason": "At least one candidate path lacks complete congestion measurements; retain baseline."}
        scores[name] = score
    if not scores:
        return {"selected_route": "baseline", "complete": False,
                "reason_code": "NO_CANDIDATE_PATHS", "scores_pct": {},
                "reason": "No candidate paths were measured."}
    selected = min(scores, key=lambda route: (scores[route], len(routes[route]), route))
    return {"selected_route": selected, "complete": True,
            "reason_code": "MINIMUM_MEASURED_BOTTLENECK_UTILIZATION",
            "scores_pct": scores,
            "reason": "Selected the route with the lowest maximum measured egress utilization."}


def sample_scenario_traffic(net, scenario, repetition, qos_enabled,
                            heavy_background, evidence_dir, routes, class_config,
                            bottleneck_evidence, workload, bottleneck_congested=None,
                            route_mode="baseline", shortcut_link=None):
    """Run simultaneous DSCP-marked UDP classes from training-derived profiles."""
    if shortcut_link is not None:
        set_shortcut_link(shortcut_link, route_mode == "shortcut")
    set_qos_enabled(qos_enabled)
    set_mode(route_mode, "scenario {} repetition {}".format(scenario, repetition))
    flows = verify_flows(scenario + "_r" + str(repetition), route_mode, evidence_dir,
                         routes, class_config)
    h1, h2 = net.get("h1", "h2")
    before = collect_port_snapshot()
    queue_before = collect_queue_occupancy(SCENARIO_BOTTLENECK_PORT)
    servers, clients, pings, ping_started = {}, {}, {}, {}
    outputs = {}
    duration = 4
    for name, profile in class_config["classes"].items():
        port = profile["udp_port"]
        servers[name] = h2.popen(["iperf3", "-s", "-1", "-p", str(port)],
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    time.sleep(.35)
    for name, profile in class_config["classes"].items():
        port, tos = profile["udp_port"], profile["dscp"] << 2
        flow_workload = workload[name]
        offered_mbps = flow_workload["offered_load_mbps"]
        clients[name] = h1.popen(["iperf3", "-c", "10.0.0.2", "-p", str(port),
            "-u", "-b", "{}M".format(offered_mbps),
            "-l", str(flow_workload["dataset_packet_size_bytes"]),
            "-t", str(duration), "-J", "--get-server-output", "-S", str(tos)],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        ping_started[name] = time.time()
        pings[name] = h1.popen(["ping", "-n", "-c", str(SCENARIO_PING_SAMPLES), "-i", "0.1", "-W", "2",
                                "-Q", str(tos), "10.0.0.2"],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    class_results = {}
    try:
        for name, proc in pings.items():
            try:
                outputs["ping_" + name], _ = proc.communicate(timeout=15)
            except subprocess.TimeoutExpired:
                proc.kill()
                outputs["ping_" + name], _ = proc.communicate()
        for name, proc in clients.items():
            try:
                outputs["client_" + name], _ = proc.communicate(timeout=10)
            except subprocess.TimeoutExpired:
                proc.terminate()
                outputs["client_" + name], _ = proc.communicate(timeout=2)
        for name, proc in servers.items():
            try:
                outputs["server_" + name], _ = proc.communicate(timeout=3)
            except subprocess.TimeoutExpired:
                proc.terminate()
                outputs["server_" + name], _ = proc.communicate(timeout=2)
    finally:
        for proc in list(pings.values()) + list(clients.values()) + list(servers.values()):
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.communicate(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.communicate()
    for name, profile in class_config["classes"].items():
        flow_workload = workload[name]
        raw = outputs.get("ping_" + name, "")
        observed = {int(sequence): float(value) for sequence, value in re.findall(
            r"icmp_seq=(\d+).*?time[=<]([0-9.]+)\s*ms", raw)}
        samples = [{"timestamp": ping_started[name] + (i - 1) * .1,
                    "rtt_ms": observed.get(i)} for i in range(1, SCENARIO_PING_SAMPLES + 1)]
        ping_metrics = summarize_samples(samples, expected_samples=SCENARIO_PING_SAMPLES)
        received_mbps = udp_loss = None
        try:
            result = json.loads(outputs.get("client_" + name, ""))
            server_output = result.get("server_output_text")
            receiver_result = {}
            if isinstance(server_output, str):
                try:
                    receiver_result = json.loads(server_output)
                except json.JSONDecodeError:
                    receiver_result = {}
            receiver_end = receiver_result.get("end", {})
            end = (receiver_end.get("sum_received") or receiver_end.get("sum") or
                   result.get("end", {}).get("sum_received", {}))
            bps = end.get("bits_per_second")
            loss_value = end.get(" lost_percent")
            if loss_value is None:
                loss_value = end.get("lost_percent")
            if (not isinstance(bps, (int, float)) or
                    not isinstance(loss_value, (int, float))) and isinstance(server_output, str):
                match = re.search(
                    r"([0-9.]+)\s+([KMG])bits/sec.*?\(([0-9.]+)%\).*receiver\s*$",
                    server_output, re.MULTILINE)
                if match:
                    multiplier = {"K": 1_000, "M": 1_000_000, "G": 1_000_000_000}[match.group(2)]
                    bps = float(match.group(1)) * multiplier
                    loss_value = float(match.group(3))
            if isinstance(bps, (int, float)) and math.isfinite(bps) and bps >= 0:
                received_mbps = bps / 1_000_000
            if isinstance(loss_value, (int, float)) and math.isfinite(loss_value) and 0 <= loss_value <= 100:
                udp_loss = loss_value
        except (json.JSONDecodeError, AttributeError):
            pass
        latency = ping_metrics.get("latency_ms") if ping_metrics else None
        jitter = ping_metrics.get("jitter_ms") if ping_metrics else None
        complete = latency is not None and jitter is not None and udp_loss is not None and received_mbps is not None
        cost = ((latency / COST_REFERENCES["latency_ms"] +
                 jitter / COST_REFERENCES["jitter_ms"] +
                 udp_loss / COST_REFERENCES["packet_loss_pct"]) / 3) if complete else None
        class_results[name] = {"complete": complete,
            "metrics": {"complete": complete, "latency_ms": latency, "jitter_ms": jitter,
                        "packet_loss_pct": udp_loss,
                        "reliability_pct": 100 - udp_loss if udp_loss is not None else None,
                        "ping_packet_loss_pct":
                            ping_metrics.get("packet_loss_pct") if ping_metrics else None,
                        "cost": cost},
            "throughput_mbps": received_mbps,
            **flow_workload,
            "dscp": profile["dscp"], "udp_port": profile["udp_port"],
            "queue_id": profile["queue_id"] if qos_enabled else None,
            "ping_samples": samples,
            "error": None if complete else "incomplete class scenario telemetry"}
    class_flow_usage = collect_scenario_flow_usage(
        scenario, repetition, evidence_dir, class_config, qos_enabled)
    flows["class_traffic_usage"] = class_flow_usage
    after = collect_port_snapshot()
    queue_after = collect_queue_occupancy(SCENARIO_BOTTLENECK_PORT)
    bottleneck_active = (heavy_background if bottleneck_congested is None
                         else bottleneck_congested)
    capacity_overrides = ({("s1", 2): SCENARIO_BOTTLENECK_CAPACITY_MBPS}
                          if bottleneck_active else {})
    links = calculate_link_utilization(before, after,
        class_config["link_capacity_mbps"], capacity_overrides)
    record = {"scenario": scenario, "repetition": repetition,
        "qos_enabled": qos_enabled, "heavy_background": heavy_background,
        "route": route_mode, "duration_seconds": duration,
        "bottleneck_congested": bottleneck_active,
        "latency_probe_count": SCENARIO_PING_SAMPLES,
        "bottleneck": bottleneck_evidence,
        "per_class_metrics": class_results, "link_utilization": links,
        "queue_occupancy": summarize_queue_occupancy(queue_before, queue_after),
        "flow_evidence": flows,
        "complete": (all(item["complete"] for item in class_results.values()) and
                     links["complete"] and class_flow_usage["complete"]),
        "raw_process_output": outputs}
    save_json(evidence_dir / ("scenario_{}_r{}.json".format(scenario, repetition)), record)
    return record


def run_braess_repetition(net, repetition, shortcut_link, evidence_dir, routes, class_config):
    set_qos_enabled(True)
    baseline = measure_route_condition(net, "baseline", shortcut_link, evidence_dir, routes, class_config)
    shortcut = measure_route_condition(net, "shortcut", shortcut_link, evidence_dir, routes, class_config)
    decision = classify(baseline, shortcut)
    if not decision.get("reason"):
        decision["reason"] = ("shortcut cost exceeded baseline by more than {:.0%} threshold".format(THRESHOLD)
            if decision["verdict"] == "harmful" else
            "shortcut cost was more than {:.0%} below baseline".format(THRESHOLD)
            if decision["verdict"] == "beneficial" else
            "shortcut cost was within the {:.0%} neutral band".format(THRESHOLD))
    selected = decision["mode"]
    prevention = measure_route_condition(net, selected, shortcut_link,
                                         evidence_dir, routes, class_config)
    flows_verified = all(item["flow_evidence"]["verified"]
                         for item in (baseline, shortcut, prevention))
    route_selection_verified = bool(
        (selected == decision["mode"] or
         decision["verdict"] == "inconclusive" and selected == "baseline") and flows_verified)
    decision_record = {"repetition": repetition, "verdict": decision["verdict"],
        "selected_route": selected, "reason": decision["reason"],
        "threshold_fraction": THRESHOLD,
        "metrics_used": {"baseline": baseline["metrics"], "shortcut": shortcut["metrics"]},
        "prevention_metrics": prevention["metrics"],
        "prevention_verified": harmful_shortcut_prevented(
            decision["verdict"], selected, prevention["complete"], flows_verified, True),
        "route_selection_verified": route_selection_verified, "flows_verified": flows_verified,
        "sample_timestamps": {"baseline": [x["timestamp"] for x in baseline["samples"]],
            "shortcut": [x["timestamp"] for x in shortcut["samples"]]}}
    try:
        posted = request_json("POST", decision_record, timeout=3, endpoint=DECISION_API)
        decision_record["controller_recorded"] = bool(posted.get("recorded"))
    except Exception as exc:
        decision_record["controller_recorded"] = False
        decision_record["controller_error"] = type(exc).__name__ + ": " + str(exc)
    # Prevention is a route control claim: after a harmful candidate measurement,
    # confirm that the selected baseline route is actually installed and that the
    # follow-up telemetry and controller decision record are present. The follow-up
    # cost is reported, but a noisy new sample must not invalidate forwarding proof.
    decision_record["prevention_verified"] = bool(
        decision_record["prevention_verified"] and decision_record["controller_recorded"])
    return {"repetition": repetition, "baseline": baseline, "shortcut": shortcut,
            "prevention": prevention, "decision": decision_record,
            "complete": all(item["complete"] for item in (baseline, shortcut, prevention)),
            "prevention_verified": decision_record["prevention_verified"] and
                                  decision_record["controller_recorded"]}


def run_congestion_route_repetition(net, repetition, shortcut_link, evidence_dir,
                                    routes, class_config):
    """Choose a route from observed path bottleneck utilization, without CBDR."""
    route_rows = []
    for mode in ("baseline", "alternate", "shortcut"):
        route_rows.append(measure_route_condition(
            net, mode, shortcut_link, evidence_dir, routes, class_config))
    selection = select_congestion_route(route_rows, routes)
    selected = selection["selected_route"]
    set_shortcut_link(shortcut_link, selected == "shortcut")
    set_mode(selected, "M3 minimum measured path congestion")
    flow_evidence = verify_flows(
        "m3_selected_r{}".format(repetition), selected, evidence_dir,
        routes, class_config)
    measurements_complete = bool(
        selection.get("complete") and
        route_rows and
        all(bool(row.get("complete")) for row in route_rows)
    )
    flows_verified = bool(flow_evidence.get("verified"))
    route_selection_verified = bool(measurements_complete and flows_verified)
    route_details = {
        row["mode"]: {
            "congestion_score_pct": selection.get("scores_pct", {}).get(row["mode"]),
            "throughput_mbps": row.get("throughput_mbps"),
            "complete": bool(row.get("complete")),
        }
        for row in route_rows if isinstance(row, dict) and "mode" in row
    }
    metrics_used = {
        "path_congestion_scores_pct": dict(selection.get("scores_pct", {})),
        "route_congestion_scores": {
            row["mode"]: selection.get("scores_pct", {}).get(row["mode"])
            for row in route_rows if isinstance(row, dict) and "mode" in row
        },
        "routes": route_details,
    }
    decision = {"repetition": repetition, "method": "M3", "verdict": "inconclusive",
        "classification": "congestion_selected",
        "original_classification": "congestion_selected",
        "selected_route": selected, "reason": selection.get("reason") or "M3 congestion selection",
        "reason_code": selection.get("reason_code"),
        "metrics_used": metrics_used,
        "path_congestion_scores_pct": selection.get("scores_pct", {}),
        "route_selection_verified": route_selection_verified,
        "prevention_verified": False, "flows_verified": flows_verified}
    try:
        posted = request_json("POST", decision, timeout=3, endpoint=DECISION_API)
        decision["controller_recorded"] = bool(posted.get("recorded"))
    except Exception as exc:
        decision["controller_recorded"] = False
        decision["controller_error"] = type(exc).__name__ + ": " + str(exc)
    record = {"repetition": repetition, "method": "M3",
        "selected_route": selected, "selection": selection,
        "route_measurements": route_rows,
        "route_selection_verified": route_selection_verified,
        "flow_evidence": flow_evidence,
        "decision": decision,
        "prevention_verified": False,
        "complete": bool(route_selection_verified and decision.get("controller_recorded"))}
    return record


CBDR_PROFILE_BY_CATALOG = {
    "ECG": "EMERGENCY_ALARM",
    "ICU": "CRITICAL_PHYSIOLOGICAL_TELEMETRY",
    "TELEMEDICINE": "REAL_TIME_CLINICAL_VIDEO",
    "EHR": "EHR_TRANSACTIONS",
    "IMAGING": "MEDICAL_IMAGING",
    "CCTV": "CCTV_BACKGROUND",
}


def jain_index(values):
    if not values or any(not isinstance(value, (int, float)) or
                         not math.isfinite(value) or value < 0 for value in values):
        return None
    denominator = len(values) * sum(value * value for value in values)
    return sum(values) ** 2 / denominator if denominator > 0 else None


def _profile_objective_record(row, profile_name, route):
    metrics = dict(row.get("metrics") or {})
    complete = bool(row.get("complete") and metrics.get("complete"))
    return {"topology": "four_switch_diamond" + ("_with_shortcut" if route == "shortcut" else ""),
            "route": route, "timestamp": row.get("captured_at", row.get("timestamp")),
            "complete": complete, "metrics": metrics,
            "source": "measured_catalog_service_flow:{}".format(profile_name)}


def run_cbdr_repetition(net, repetition, shortcut_link, evidence_dir, routes,
                        class_config, traffic_catalog, qos_enabled=True,
                        random_seed=None, ablation=None):
    """Run paired class-tagged profile probes and apply the CBDR objective."""
    from cbdr import load_config, evaluate_class_aware_candidate
    policy_config = load_config()
    before_by_class, after_by_class = {}, {}
    baseline_rows, candidate_rows = [], []
    if ablation == "disable_link_change_evaluation":
        set_shortcut_link(shortcut_link, False)
        set_mode("baseline", "M4 ablation: link-change evaluation disabled")
        baseline_only = run_catalog_profile_matrix(net, traffic_catalog, class_config,
            evidence_dir, routes, method_qos_enabled=qos_enabled,
            route_mode="baseline", shortcut_link=shortcut_link,
            run_tag="r{}_baseline_only".format(repetition), random_seed=random_seed)
        verified = bool(baseline_only) and all(row.get("complete") for row in baseline_only)
        record = {"repetition": repetition, "method": "M4", "complete": verified,
                  "ablation": ablation,
                  "decision": {"selected_route": "baseline", "verdict": "not_evaluated",
                               "reason": "candidate link evaluation disabled by ablation",
                               "route_selection_verified": verified,
                               "flows_verified": verified},
                  "baseline_profiles": baseline_only, "candidate_profiles": []}
        save_json(evidence_dir / "cbdr_repetition_r{}.json".format(repetition), record)
        return record
    for source in traffic_catalog["rows"]:
        profile_name = CBDR_PROFILE_BY_CATALOG.get(source["traffic_type"])
        if profile_name not in policy_config["classes"]:
            return {"repetition": repetition, "method": "M4", "complete": False,
                    "error": "catalog profile has no CBDR policy mapping: " + source["traffic_type"]}
        baseline = run_catalog_profile_matrix(net, traffic_catalog, class_config,
            evidence_dir, routes, method_qos_enabled=qos_enabled,
            route_mode="baseline", shortcut_link=shortcut_link,
            profile_rows=[source], run_tag="r{}_baseline".format(repetition),
            save_output=False, random_seed=random_seed)[0]
        candidate = run_catalog_profile_matrix(net, traffic_catalog, class_config,
            evidence_dir, routes, method_qos_enabled=qos_enabled,
            route_mode="shortcut", shortcut_link=shortcut_link,
            profile_rows=[source], run_tag="r{}_shortcut".format(repetition),
            save_output=False, random_seed=random_seed)[0]
        before_by_class[profile_name] = _profile_objective_record(
            baseline, profile_name, "baseline")
        after_by_class[profile_name] = _profile_objective_record(
            candidate, profile_name, "shortcut")
        baseline["cbdr_profile"] = profile_name
        candidate["cbdr_profile"] = profile_name
        baseline_rows.append(baseline)
        candidate_rows.append(candidate)
    if len(before_by_class) != len(policy_config["classes"]):
        return {"repetition": repetition, "method": "M4", "complete": False,
                "error": "CBDR profile set does not match measured catalog profiles"}
    baseline_path_util = [route_congestion_score("baseline", routes["baseline"],
        row.get("link_utilization", {})) for row in baseline_rows]
    candidate_path_util = [route_congestion_score("shortcut", routes["shortcut"],
        row.get("link_utilization", {})) for row in candidate_rows]
    complete = (all(row.get("complete") for row in baseline_rows + candidate_rows) and
                all(score is not None for score in baseline_path_util + candidate_path_util))
    if not complete:
        return {"repetition": repetition, "method": "M4", "complete": False,
                "error": "one or more per-profile measurements or route counters are incomplete",
                "baseline_profiles": baseline_rows, "candidate_profiles": candidate_rows}
    base_fairness = jain_index([
        row["metrics"]["throughput_mbps"] / (row["offered_rate_bps"] / 1_000_000)
        for row in baseline_rows])
    candidate_fairness = jain_index([
        row["metrics"]["throughput_mbps"] / (row["offered_rate_bps"] / 1_000_000)
        for row in candidate_rows])
    evaluation = evaluate_class_aware_candidate(
        current_by_class=before_by_class, candidate_by_class=after_by_class,
        current_network_cost_pct=max(baseline_path_util),
        candidate_network_cost_pct=max(candidate_path_util),
        config=policy_config, current_fairness=base_fairness,
        candidate_fairness=candidate_fairness, now=time.time(),
        max_age_seconds=CBDR_BATCH_MAX_AGE)
    selected = ("shortcut" if evaluation["decision"] == "accept_candidate"
                else "baseline")
    if ablation == "disable_braess_detection":
        selected = "shortcut"
        evaluation["ablation_override"] = "disabled_rejection_and_accept_shortcut"
    set_shortcut_link(shortcut_link, selected == "shortcut")
    set_mode(selected, "M4 CBDR {} decision".format(evaluation["classification"]))
    final_flows = verify_flows("m4_selected_r{}".format(repetition), selected,
                               evidence_dir, routes, class_config)
    evaluation["route_installation_verified"] = bool(final_flows["verified"])
    evaluation["route_installation_verification_status"] = (
        "verified" if final_flows["verified"] else "failed")
    original_classification = evaluation.get("classification")
    original_reason_code = evaluation.get("reason_code")
    if original_classification == "constraint_violation":
        controller_verdict = "harmful" if evaluation.get("decision") != "accept_candidate" else "beneficial"
    elif original_classification in ("harmful", "beneficial", "neutral", "inconclusive"):
        controller_verdict = original_classification
    else:
        controller_verdict = "inconclusive"

    baseline_profile_metrics = {
        row["cbdr_profile"]: row.get("metrics")
        for row in baseline_rows
        if isinstance(row, dict) and "cbdr_profile" in row and row.get("metrics")
    }
    candidate_profile_metrics = {
        row["cbdr_profile"]: row.get("metrics")
        for row in candidate_rows
        if isinstance(row, dict) and "cbdr_profile" in row and row.get("metrics")
    }
    metrics_used = {
        "baseline": {
            "cost": evaluation.get("current_objective"),
            "network_cost_pct": evaluation.get("current_network_cost_pct"),
            "fairness": base_fairness,
            "profiles": baseline_profile_metrics,
        },
        "shortcut": {
            "cost": evaluation.get("candidate_objective"),
            "network_cost_pct": evaluation.get("candidate_network_cost_pct"),
            "fairness": candidate_fairness,
            "profiles": candidate_profile_metrics,
        },
        "current_objective": evaluation.get("current_objective"),
        "candidate_objective": evaluation.get("candidate_objective"),
        "relative_change": evaluation.get("relative_change"),
        "current_network_cost_pct": evaluation.get("current_network_cost_pct"),
        "candidate_network_cost_pct": evaluation.get("candidate_network_cost_pct"),
        "baseline_fairness": base_fairness,
        "candidate_fairness": candidate_fairness,
        "baseline_hard_violations": evaluation.get("baseline_hard_violations", []),
        "candidate_hard_violations": evaluation.get("candidate_hard_violations", []),
    }
    flows_verified = bool(final_flows.get("verified"))
    route_selection_verified = bool(flows_verified and complete)
    prevention_candidate = bool(
        original_classification in ("harmful", "constraint_violation") and
        selected == "baseline" and
        evaluation.get("decision") != "accept_candidate" and
        flows_verified
    )
    decision = {"repetition": repetition, "method": "M4", "verdict": controller_verdict,
        "classification": original_classification,
        "original_classification": original_classification,
        "selected_route": selected, "reason": evaluation.get("explanation") or "M4 CBDR decision",
        "reason_code": original_reason_code, "evaluation": evaluation,
        "structured_evaluation": evaluation,
        "metrics_used": metrics_used,
        "route_selection_verified": route_selection_verified,
        "flows_verified": flows_verified,
        "prevention_verified": prevention_candidate}
    try:
        posted = request_json("POST", decision, timeout=3, endpoint=DECISION_API)
        decision["controller_recorded"] = bool(posted.get("recorded"))
    except Exception as exc:
        decision["controller_recorded"] = False
        decision["controller_error"] = type(exc).__name__ + ": " + str(exc)
    decision["prevention_verified"] = bool(
        prevention_candidate and decision["controller_recorded"])
    record = {"repetition": repetition, "method": "M4", "complete": bool(
        complete and decision["controller_recorded"] and route_selection_verified),
        "decision": decision, "evaluation": evaluation,
        "baseline_profiles": baseline_rows, "candidate_profiles": candidate_rows,
        "final_flow_evidence": final_flows,
        "baseline_fairness": base_fairness,
        "candidate_fairness": candidate_fairness,
        "ablation": ablation,
        "prevention_verified": decision["prevention_verified"]}
    save_json(evidence_dir / "cbdr_repetition_r{}.json".format(repetition), record)
    return record


def summarize_scenario_repetitions(repetitions, class_config):
    summary = {"repetition_count": len(repetitions), "classes": {}}
    fields = ("latency_ms", "jitter_ms", "packet_loss_pct", "throughput_mbps")
    def stats(values):
        return {"n": len(values), "mean": statistics.mean(values) if values else None,
                "standard_deviation": statistics.stdev(values) if len(values) > 1 else None,
                "complete": len(values) == len(repetitions) and bool(repetitions)}
    for traffic_class in class_config["classes"]:
        summary["classes"][traffic_class] = {}
        for field in fields:
            values = []
            for repetition in repetitions:
                item = repetition.get("per_class_metrics", {}).get(traffic_class, {})
                value = ((item.get("metrics") or {}).get(field) if field != "throughput_mbps"
                         else item.get(field))
                if (isinstance(value, (int, float)) and not isinstance(value, bool) and
                        math.isfinite(value) and value >= 0 and
                        (field != "packet_loss_pct" or value <= 100)):
                    values.append(value)
            summary["classes"][traffic_class][field] = stats(values)
        # Per-packet probe samples support tail latency and configurable deadline
        # accounting. These are network experiment targets, not clinical SLAs.
        probe_samples = [sample
            for repetition in repetitions
            for sample in (repetition.get("per_class_metrics", {}).get(
                traffic_class, {}).get("ping_samples")
                if isinstance(repetition.get("per_class_metrics", {}).get(
                    traffic_class, {}).get("ping_samples"), list) else [])]
        samples = [sample["rtt_ms"] for sample in probe_samples
            if isinstance(sample, dict) and
            isinstance(sample.get("rtt_ms"), (int, float)) and
            not isinstance(sample.get("rtt_ms"), bool) and
            math.isfinite(sample["rtt_ms"]) and sample["rtt_ms"] >= 0]
        raw_objectives = class_config["classes"][traffic_class].get("objectives", {})
        objectives = raw_objectives if isinstance(raw_objectives, dict) else {}
        deadline = objectives.get("delay_deadline_ms")
        if (isinstance(deadline, bool) or not isinstance(deadline, (int, float)) or
                not math.isfinite(deadline) or deadline <= 0):
            deadline = None
        tail = {"sample_count": len(samples), "p95_ms": None, "p99_ms": None,
                "deadline_ms": deadline, "deadline_miss_count": None,
                "deadline_miss_rate_pct": None,
                "probe_count": len(probe_samples),
                "target_source": objectives.get("target_source", "unspecified")}
        if samples:
            ordered = sorted(samples)
            tail["p95_ms"] = ordered[max(0, math.ceil(.95 * len(ordered)) - 1)]
            tail["p99_ms"] = ordered[max(0, math.ceil(.99 * len(ordered)) - 1)]
        if deadline is not None and probe_samples:
            timely = sum(value <= deadline for value in samples)
            misses = len(probe_samples) - timely
            tail["deadline_miss_count"] = misses
            tail["deadline_miss_rate_pct"] = 100 * misses / len(probe_samples)
        loss_values = []
        expected_repetitions = len(repetitions)
        invalid_loss = False
        for repetition in repetitions:
            value = ((repetition.get("per_class_metrics", {}).get(traffic_class, {}).get(
                "metrics") or {}).get("packet_loss_pct"))
            if (isinstance(value, (int, float)) and not isinstance(value, bool) and
                    math.isfinite(value) and 0 <= value <= 100):
                loss_values.append(value)
            else:
                invalid_loss = True
        max_loss = objectives.get("max_packet_loss_pct")
        min_reliability = objectives.get("min_reliability_pct")
        if (isinstance(max_loss, bool) or not isinstance(max_loss, (int, float)) or
                not math.isfinite(max_loss) or not 0 <= max_loss <= 100):
            max_loss = None
        if (isinstance(min_reliability, bool) or not isinstance(min_reliability, (int, float)) or
                not math.isfinite(min_reliability) or not 0 <= min_reliability <= 100):
            min_reliability = None
        tail["mean_packet_loss_pct"] = statistics.mean(loss_values) if loss_values else None
        tail["loss_observation_count"] = len(loss_values)
        tail["max_packet_loss_pct"] = max_loss
        tail["min_reliability_pct"] = min_reliability
        complete_loss = (expected_repetitions > 0 and len(loss_values) == expected_repetitions
                         and not invalid_loss)
        tail["receiver_delivery_reliability_pct"] = (
            100 - statistics.mean(loss_values) if complete_loss else None)
        tail["packet_loss_target_met"] = (
            statistics.mean(loss_values) <= max_loss
            if complete_loss and max_loss is not None else None)
        tail["delay_target_met"] = (None if tail["deadline_miss_rate_pct"] is None else
                                     tail["deadline_miss_rate_pct"] == 0)
        tail["reliability_target_met"] = (
            tail["receiver_delivery_reliability_pct"] >= min_reliability
            if tail["receiver_delivery_reliability_pct"] is not None and
            min_reliability is not None else None)
        summary["classes"][traffic_class]["tail_latency"] = tail
    # Report Jain fairness only when every configured class has complete, valid
    # throughput observations. Omitting a missing class would overstate coverage.
    rates = [entry["throughput_mbps"]["mean"]
             for entry in summary["classes"].values()]
    fairness_complete = bool(repetitions) and bool(rates) and all(
        entry["throughput_mbps"]["n"] == len(repetitions) and
        entry["throughput_mbps"]["mean"] is not None and
        entry["throughput_mbps"]["mean"] >= 0
        for entry in summary["classes"].values())
    denominator = len(rates) * sum(x * x for x in rates) if fairness_complete else 0
    summary["throughput_fairness"] = {
        "metric": "jain_fairness_index", "n_classes": sum(
            entry["throughput_mbps"]["n"] == len(repetitions) and bool(repetitions)
            for entry in summary["classes"].values()),
        "expected_classes": len(class_config["classes"]),
        "complete": fairness_complete and denominator > 0,
        "unavailable_reason": (None if fairness_complete and denominator > 0 else
            "missing_or_invalid_class_throughput" if not fairness_complete else
            "total_throughput_is_zero"),
        "jain_index": (sum(rates) ** 2 / denominator)
            if fairness_complete and denominator > 0 else None,
        "class_throughput_mbps": {name: entry["throughput_mbps"]["mean"]
            for name, entry in summary["classes"].items()}}
    links = {}
    for repetition in repetitions:
        for link in repetition.get("link_utilization", {}).get("links", []):
            entry = links.setdefault(link["name"], {"rx_mbps": [], "tx_mbps": [],
                "rx_utilization_pct": [], "tx_utilization_pct": []})
            for field in entry:
                value = link.get(field)
                if isinstance(value, (int, float)) and math.isfinite(value):
                    entry[field].append(value)
    summary["links"] = {name: {field: stats(values) for field, values in fields.items()}
                        for name, fields in links.items()}
    return summary


def summarize_telemetry_completeness(records, scenario_statistics,
                                     scenario_repetitions, candidate_evaluations=()):
    """Separate required route telemetry from optional metric coverage."""
    stages = [record for record in records if isinstance(record, dict)]
    required_complete = bool(stages) and all(
        stage_measurement_complete(record) for record in stages)
    fairness_statuses = [
        (evaluation.get("fairness") or {}).get("status")
        for evaluation in candidate_evaluations
        if isinstance(evaluation, dict)
    ]
    scenario_fairness = [
        (stats.get("throughput_fairness") or {}).get("complete")
        for stats in scenario_statistics.values()
        if isinstance(stats, dict) and "throughput_fairness" in stats
    ]
    queue_records = [
        row.get("queue_occupancy", {})
        for rows in scenario_repetitions.values()
        for row in rows
        if isinstance(row, dict)
    ]
    optional = {
        "candidate_evaluation_fairness": (
            all(status == "measured" for status in fairness_statuses)
            if fairness_statuses else None
        ),
        "scenario_throughput_fairness": (
            all(value is True for value in scenario_fairness)
            if scenario_fairness else None
        ),
        "queue_occupancy": (
            all(record.get("complete") is True for record in queue_records)
            if queue_records else None
        ),
    }
    applicable_optional = [value for value in optional.values() if value is not None]
    return {
        "required_telemetry_complete": required_complete,
        "optional_telemetry": optional,
        "optional_telemetry_complete": (
            bool(applicable_optional) and all(applicable_optional)
        ),
        "all_telemetry_complete": (
            required_complete and bool(applicable_optional) and
            all(applicable_optional)
        ),
    }


def summarize_braess_repetitions(repetitions):
    output = {"repetition_count": len(repetitions), "verdict_counts": {},
              "prevention_verified_count": sum(bool(item.get("prevention_verified"))
                                                for item in repetitions),
              "uncertainty_kind": "descriptive_interval_over_current_repetitions; independent seeds required for inference",
              "costs": {}}
    for item in repetitions:
        verdict = item.get("decision", {}).get("verdict", "unavailable")
        output["verdict_counts"][verdict] = output["verdict_counts"].get(verdict, 0) + 1
    for route in ("baseline", "shortcut", "prevention"):
        values = []
        for row in repetitions:
            metrics = row.get(route, {}).get("metrics") or {}
            value = metrics.get("cost")
            if isinstance(value, (int, float)) and math.isfinite(value):
                values.append(value)
        entry = {"n": len(values),
            "mean": statistics.mean(values) if values else None,
            "standard_deviation": statistics.stdev(values) if len(values) > 1 else None}
        if len(values) > 1:
            entry["confidence_interval_95"] = confidence_interval_95(values)
        output["costs"][route] = entry
    return output


def summarize_repeated_decisions(repetitions):
    """Aggregate every route decision without letting an early trial mask later harm."""
    if not repetitions:
        return {"live_experiment": "inconclusive", "aggregate_verdict": "inconclusive", "passed": False,
                "harmful_candidate_count": 0, "prevention_verified_count": 0,
                "verdict_counts": {}, "errors": ["no candidate decisions were recorded"]}
    counts = {}
    errors = []
    harmful = []
    for row in repetitions:
        decision = row.get("decision", {})
        verdict = decision.get("verdict", "unavailable")
        counts[verdict] = counts.get(verdict, 0) + 1
        if not row.get("complete") or not decision.get("controller_recorded") or not decision.get("route_selection_verified"):
            errors.append("repetition {} lacks complete measurements, controller decision, or route verification".format(
                row.get("repetition", "unknown")))
        if verdict == "harmful":
            harmful.append(row)
            if not decision.get("prevention_verified"):
                errors.append("harmful candidate in repetition {} was not verified as prevented".format(
                    row.get("repetition", "unknown")))
        elif verdict == "inconclusive":
            errors.append("repetition {} produced an inconclusive candidate decision".format(
                row.get("repetition", "unknown")))
    if harmful:
        status = "harmful_shortcut_prevented" if not errors else "prevention_failed"
    elif errors:
        status = "inconclusive"
    else:
        status = "shortcut_not_harmful_under_test"
    aggregate_verdict = next(iter(counts)) if len(counts) == 1 else "mixed"
    return {"live_experiment": status, "aggregate_verdict": aggregate_verdict,
            "passed": not errors,
            "harmful_candidate_count": len(harmful),
            "prevention_verified_count": sum(bool(row.get("decision", {}).get("prevention_verified"))
                                                for row in harmful),
            "verdict_counts": counts, "errors": errors}


def harmful_shortcut_prevented(verdict, selected_route, prevention_complete,
                               flows_verified, controller_recorded):
    """Return whether a harmful shortcut was measurably rejected and baseline restored."""
    return bool(verdict == "harmful" and selected_route == "baseline" and
                prevention_complete and flows_verified and controller_recorded)


def stage_measurement_complete(stage):
    """Read completion from either a paired route result or a saved stage result."""
    if stage.get("complete") is True:
        return True
    metrics = stage.get("metrics")
    return bool(isinstance(metrics, dict) and metrics.get("complete") is True)


def set_shortcut_link(link, enabled):
    state = "up" if enabled else "down"
    link.intf1.ifconfig(state)
    link.intf2.ifconfig(state)


def set_link_state(link, enabled):
    state = "up" if enabled else "down"
    link.intf1.ifconfig(state)
    link.intf2.ifconfig(state)


def run_link_failure_recovery(net, failed_link, shortcut_link, evidence_dir,
                              routes, class_config, method_qos_enabled=True):
    """Verify the alternate route while the primary inter-switch link is down."""
    started = time.monotonic()
    set_qos_enabled(method_qos_enabled)
    set_shortcut_link(shortcut_link, True)
    set_link_state(failed_link, False)
    failure_signalled = time.monotonic()
    try:
        computation_started = time.monotonic()
        set_mode("recovery", "primary link failure recovery")
        installation_confirmed = time.monotonic()
        flows = verify_flows("failure_recovery", "recovery", evidence_dir,
                             routes, class_config)
        h1, h2 = net.get("h1", "h2")
        probe = h1.cmd("ping -n -c 3 -W 2 10.0.0.2")
        received_match = re.search(r"(\d+) received", probe)
        received = int(received_match.group(1)) if received_match else 0
        result = {
            "failed_link": [failed_link.intf1.name, failed_link.intf2.name],
            "selected_route": "recovery",
            "connectivity": {"received": received, "probe": probe},
            "flows_verified": flows["verified"],
            "timing_ms": {
                # These are controller/runner timestamps, not a claim of
                # instantaneous data-plane failover. Packet loss is measured
                # only by the recorded post-update probe below.
                "failure_detection_signal": round((failure_signalled - started) * 1000, 3),
                "route_computation_and_request": round((installation_confirmed - computation_started) * 1000, 3),
                "rule_installation_to_probe": round((time.monotonic() - installation_confirmed) * 1000, 3),
                "end_to_end_recovery_probe": round((time.monotonic() - started) * 1000, 3),
            },
            "complete": received >= 1 and flows["verified"],
        }
        save_json(evidence_dir / "failure_recovery.json", result)
        if not result["complete"]:
            raise RuntimeError("link-failure recovery did not preserve connectivity")
        return result
    finally:
        set_link_state(failed_link, True)
        set_shortcut_link(shortcut_link, False)
        set_qos_enabled(method_qos_enabled)


def classify(baseline, candidate, now=None):
    now = time.time() if now is None else now
    for record in (baseline, candidate):
        paired = record.get("decision_probe")
        if paired is not None and not paired.get("complete"):
            return {"verdict": "inconclusive", "mode": "baseline",
                    "reason": "paired route measurement incomplete"}
        samples = record.get("samples", [])
        if len(samples) != SAMPLES:
            return {"verdict": "inconclusive", "mode": "baseline", "reason": "incomplete probe set"}
        if not isinstance(record.get("valid_count"), int) or record["valid_count"] < 3:
            return {"verdict": "inconclusive", "mode": "baseline", "reason": "too few successful RTT samples"}
        if any(not isinstance(s, dict) or "rtt_ms" not in s or "timestamp" not in s or
               not isinstance(s["timestamp"], (int, float)) or not math.isfinite(s["timestamp"]) or
               (s["rtt_ms"] is not None and (not isinstance(s["rtt_ms"], (int, float)) or
                not math.isfinite(s["rtt_ms"]) or s["rtt_ms"] < 0)) for s in samples):
            return {"verdict": "inconclusive", "mode": "baseline", "reason": "invalid RTT telemetry"}
        if any(now - s["timestamp"] > MAX_AGE or now < s["timestamp"] for s in samples):
            return {"verdict": "inconclusive", "mode": "baseline", "reason": "stale RTT samples"}
    bm, cm = baseline.get("metrics"), candidate.get("metrics")
    if not bm or not cm or not bm.get("complete") or not cm.get("complete"):
        return {"verdict": "inconclusive", "mode": "baseline", "reason": "incomplete latency, jitter, or packet-loss metrics"}
    b, c = bm.get("cost"), cm.get("cost")
    if any(not isinstance(x, (int, float)) or not math.isfinite(x) or x < 0 for x in (b, c)):
        return {"verdict": "inconclusive", "mode": "baseline", "reason": "invalid cost telemetry"}
    if b == 0:
        return {"verdict": "inconclusive", "mode": "baseline", "reason": "baseline cost is zero; relative comparison undefined"}
    # These route-comparison probes are aggregate path measurements; they do
    # not identify a clinical traffic class. Keep that distinction explicit.
    baseline_stamp = max(sample["timestamp"] for sample in baseline["samples"])
    candidate_stamp = max(sample["timestamp"] for sample in candidate["samples"])
    evaluation = evaluate_cbdr_candidate(
        current={"topology": "four_switch_diamond", "route": baseline.get("mode", "baseline"),
                 "timestamp": baseline_stamp, "complete": True, "metrics": bm,
                 "source": "measured_aggregate_probe"},
        candidate={"topology": "four_switch_diamond_with_candidate_link",
                   "route": candidate.get("mode", "shortcut"), "timestamp": candidate_stamp,
                   "complete": True, "metrics": cm, "source": "measured_aggregate_probe"},
        now=now, max_age_seconds=CBDR_BATCH_MAX_AGE, constraint_mode="experimental",
        neutral_policy="accept_candidate")
    evaluation["route_installation_verification_status"] = "pending_controller_action"
    evaluation["fairness"] = {
        "status": "unavailable",
        "reason": "aggregate_route_probe_has_no_per_class_throughput",
    }
    return {"verdict": evaluation["classification"], "mode":
            "shortcut" if evaluation["decision"] == "accept_candidate" else "baseline",
            "ratio": c / b if b else None,
            "reason": evaluation["explanation"],
            "reason_code": evaluation["reason_code"],
            "structured_evaluation": evaluation}


def run_catalog_profile_matrix(net, traffic_catalog, class_config, evidence_dir,
                               routes, method_qos_enabled=True, route_mode="baseline",
                               shortcut_link=None, profile_rows=None, run_tag="",
                               save_output=True, random_seed=None):
    """Exercise each catalog profile through its deterministic MedRoute class.

    Catalog ports are metadata and are not controller policy ports. Each profile
    therefore uses the existing policy port/DSCP for its mapped class, while the
    original catalog values remain recorded for provenance.
    """
    if shortcut_link is not None:
        set_shortcut_link(shortcut_link, route_mode == "shortcut")
    set_qos_enabled(method_qos_enabled)
    set_mode(route_mode, "catalog profile matrix {}".format(run_tag or route_mode))
    h1, h2 = net.get("h1", "h2")
    from cbdr import load_config as load_cbdr_config
    cbdr_profiles = load_cbdr_config()["classes"]
    results = []
    catalog_rows = profile_rows if profile_rows is not None else traffic_catalog["rows"]
    try:
        for row in catalog_rows:
            score = float(row["criticality"]) * 20
            traffic_class = ("ECG" if score >= 90 else "ICU" if score >= 70 else
                             "WEARABLE" if score >= 40 else "BACKGROUND")
            policy = class_config["classes"][traffic_class]
            tag = "_".join(part for part in (str(row["traffic_type"]).lower(),
                                              route_mode, str(run_tag)) if part)
            stage = "catalog_" + tag
            flow_evidence = verify_flows(stage, route_mode, evidence_dir, routes,
                                         class_config)
            port = int(policy["udp_port"])
            tos = int(policy["dscp"]) << 2
            duration = max(2, min(4, int(float(row["duration_seconds"]))))
            seed_material = "{}:{}".format(random_seed, row["traffic_type"])
            rate_factor = (random.Random(int(hashlib.sha256(
                seed_material.encode("utf-8")).hexdigest()[:16], 16)).uniform(.9, 1.1)
                if random_seed is not None else 1.0)
            profile_name = CBDR_PROFILE_BY_CATALOG.get(row["traffic_type"])
            minimum_rate = ((cbdr_profiles.get(profile_name, {}).get("objectives", {})
                             .get("min_throughput_mbps") or 0) * 1_000_000)
            offered_rate_bps = max(float(row["offered_rate_bps"]), minimum_rate) * rate_factor
            ports_before = collect_port_snapshot()
            queue_before = collect_queue_occupancy(SCENARIO_BOTTLENECK_PORT)
            server = h2.popen(["iperf3", "-s", "-1", "-p", str(port)],
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              text=True)
            time.sleep(.25)
            client = h1.popen([
                "iperf3", "-c", "10.0.0.2", "-p", str(port), "-u",
                "-b", "{}M".format(offered_rate_bps / 1_000_000),
                "-l", str(int(row["packet_size_bytes"])), "-t", str(duration),
                "-J", "--get-server-output", "-S", str(tos)
            ], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            ping = h1.popen(["ping", "-n", "-c", "20", "-i", "0.1", "-W", "2",
                             "-Q", str(tos), "10.0.0.2"],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True)
            try:
                try:
                    ping_output, _ = ping.communicate(timeout=12)
                except subprocess.TimeoutExpired:
                    ping.kill()
                    ping_output, _ = ping.communicate()
                try:
                    client_output, _ = client.communicate(timeout=duration + 8)
                except subprocess.TimeoutExpired:
                    client.terminate()
                    client_output, _ = client.communicate(timeout=3)
                try:
                    server_output, _ = server.communicate(timeout=3)
                except subprocess.TimeoutExpired:
                    server.terminate()
                    server_output, _ = server.communicate(timeout=2)
            finally:
                for proc in (ping, client, server):
                    if proc.poll() is None:
                        proc.terminate()
                        try:
                            proc.communicate(timeout=2)
                        except subprocess.TimeoutExpired:
                            proc.kill()
                            proc.communicate()
            observed = [float(value) for value in re.findall(
                r"icmp_seq=\d+.*?time[=<]([0-9.]+)\s*ms", ping_output)]
            samples = [{"timestamp": time.time(), "rtt_ms": value}
                       for value in observed]
            ping_metrics = summarize_samples(
                samples, expected_samples=max(1, len(observed)))
            received_mbps = udp_loss = None
            try:
                payload = json.loads(client_output)
                server_text = payload.get("server_output_text")
                receiver = {}
                if isinstance(server_text, str):
                    try:
                        receiver = json.loads(server_text)
                    except json.JSONDecodeError:
                        receiver = {}
                end = (receiver.get("end", {}).get("sum_received") or
                       receiver.get("end", {}).get("sum") or
                       payload.get("end", {}).get("sum_received", {}))
                bps = end.get("bits_per_second")
                loss = end.get(" lost_percent", end.get("lost_percent"))
                if (not isinstance(bps, (int, float)) or
                        not isinstance(loss, (int, float))) and isinstance(server_text, str):
                    match = re.search(
                        r"([0-9.]+)\s+([KMG])bits/sec.*?\(([0-9.]+)%\).*receiver\s*$",
                        server_text, re.MULTILINE)
                    if match:
                        bps = float(match.group(1)) * {
                            "K": 1_000, "M": 1_000_000, "G": 1_000_000_000
                        }[match.group(2)]
                        loss = float(match.group(3))
                if isinstance(bps, (int, float)) and bps >= 0:
                    received_mbps = bps / 1_000_000
                if isinstance(loss, (int, float)) and 0 <= loss <= 100:
                    udp_loss = loss
            except (json.JSONDecodeError, AttributeError, TypeError):
                pass
            latency = ping_metrics.get("latency_ms") if ping_metrics else None
            jitter = ping_metrics.get("jitter_ms") if ping_metrics else None
            ports_after = collect_port_snapshot()
            queue_after = collect_queue_occupancy(SCENARIO_BOTTLENECK_PORT)
            path_utilization = calculate_link_utilization(
                ports_before, ports_after, class_config["link_capacity_mbps"])
            queue_metrics = summarize_queue_occupancy(queue_before, queue_after)
            complete = bool(flow_evidence.get("verified") and latency is not None and
                            jitter is not None and received_mbps is not None and
                            udp_loss is not None)
            result_metrics = {
                "complete": complete, "latency_ms": latency,
                "jitter_ms": jitter, "packet_loss_pct": udp_loss,
                "reliability_pct": 100 - udp_loss if udp_loss is not None else None,
                "throughput_mbps": received_mbps,
            }
            results.append({
                "profile": row["traffic_type"],
                "catalog": row,
                "selected_class": traffic_class,
                "criticality_score": score,
                "policy_port": port,
                "policy_dscp": int(policy["dscp"]),
                "expected_queue_id": policy["queue_id"],
                "route": route_mode,
                "captured_at": time.time(),
                "seed_rate_factor": rate_factor,
                "offered_rate_bps": offered_rate_bps,
                "flow_evidence": flow_evidence,
                "metrics": {
                    **result_metrics,
                    "ping_packet_loss_pct": ping_metrics.get("packet_loss_pct")
                        if ping_metrics else None
                },
                "link_utilization": path_utilization,
                "queue_occupancy": queue_metrics,
                "complete": complete,
                "raw_process_output": {
                    "ping": ping_output, "client": client_output,
                    "server": server_output
                },
                "execution_status": "passed" if complete else "incomplete_telemetry"
            })
    finally:
        set_qos_enabled(method_qos_enabled)
    matrix = {
        "source": traffic_catalog["source_file"],
        "source_sha256": traffic_catalog["sha256"],
        "mapping_policy": "catalog criticality * 20 mapped to the four queue classes; service profile and source port are recorded",
        "profiles": results,
        "all_profiles_executed": len(results) == len(catalog_rows),
        "all_profiles_complete": all(row["complete"] for row in results)
    }
    if save_output:
        save_json(evidence_dir / "profile_matrix.json", matrix)
    return results


def main():
    global SCENARIO_REPETITIONS
    def terminate_cleanly(signum, frame):
        raise SystemExit("received signal " + str(signum))
    signal.signal(signal.SIGTERM, terminate_cleanly)
    parser = argparse.ArgumentParser()
    parser.add_argument("--evidence-dir", required=True, type=Path)
    parser.add_argument("--repetitions", type=int, default=SCENARIO_REPETITIONS,
                        help="repetitions per scenario (default: 3)")
    parser.add_argument("--seed", type=int,
                        help="reproducible workload seed; generated and recorded when omitted")
    parser.add_argument("--method", choices=available_methods(),
                        help="M1=shortest-path baseline, M2=QoS-aware, M3=congestion-aware, M4=CBDR")
    parser.add_argument("--ablation", choices=("disable_braess_detection",
                        "disable_priority_handling", "disable_link_change_evaluation"),
                        help="M4 ablation; run separately for a controlled comparison")
    parser.add_argument("--topology-profile", choices=("balanced_diamond", "asymmetric_diamond", "low_capacity_diamond"),
                        default="balanced_diamond", help="link-rate and propagation-delay topology condition")
    parser.add_argument("--skip-failure-recovery", action="store_true",
                        help="skip the controlled primary-link failure demonstration")
    args = parser.parse_args()
    if args.ablation and args.method != "M4":
        parser.error("--ablation is available only with --method M4")
    if args.repetitions < 2:
        parser.error("--repetitions must be at least 2 to support variability estimates")
    if args.seed is not None and args.seed < 0:
        parser.error("--seed must be a non-negative integer")
    SCENARIO_REPETITIONS = args.repetitions
    random_seed = secrets.randbits(32) if args.seed is None else args.seed
    method_id = args.method
    selected_method = get_method(method_id) if method_id is not None else None
    scenario_plan = resolve_method_plan(method_id)
    out = args.evidence_dir.resolve()
    if out.exists() and any(out.iterdir()):
        parser.error("evidence directory already contains files; choose a new run directory")
    out.mkdir(parents=True, exist_ok=True)
    run_started_at = datetime.now(timezone.utc).isoformat()
    class_config = json.loads((ROOT / "sdn" / "classes.json").read_text(encoding="utf-8"))
    dataset_provenance = load_profiles(ROOT)
    traffic_catalog = load_traffic_catalog(ROOT)
    scenario_workloads = build_scenario_workloads(
        dataset_provenance, scenario_plan, class_config["classes"],
        SCENARIO_BOTTLENECK_CAPACITY_MBPS, random_seed=random_seed)
    save_json(out / "dataset_workload.json", {
        "provenance": dataset_provenance,
        "catalog": traffic_catalog,
        "workload_by_scenario_and_class": scenario_workloads,
        "mapping_policy": "All classes use the training median profile by default; BACKGROUND uses the training p75 profile when a congestion scenario is requested. In heavy scenarios its synthetic offered rate is derived as bottleneck capacity plus the other classes' nominal dataset-profile rates. This creates demand above capacity; it is not presented as dataset-native traffic.",
        "raw_packet_replay": False,
        "clinical_labels_from_dataset": False,
    })
    criticality_trace = []
    for row in traffic_catalog["rows"]:
        score = float(row["criticality"]) * 20
        traffic_class = ("ECG" if score >= 90 else "ICU" if score >= 70 else
                         "WEARABLE" if score >= 40 else "BACKGROUND")
        policy = class_config["classes"][traffic_class]
        criticality_trace.append({
            "input_profile": row["traffic_type"],
            "criticality_score": score,
            "selected_class": traffic_class,
            "service_port": int(row["destination_port"]),
            "catalog_rate_bps": int(row["offered_rate_bps"]),
            "catalog_packet_size_bytes": int(row["packet_size_bytes"]),
            "expected_queue_id": policy["queue_id"],
            "classification_source": "synthetic_catalog_criticality",
            "clinical_input": False
        })
    save_json(out / "criticality_trace.json", {
        "source": traffic_catalog["source_file"],
        "source_sha256": traffic_catalog["sha256"],
        "policy": "score = catalog criticality * 20; deterministic class thresholds; no ML",
        "records": criticality_trace
    })
    config = {"topology": "4-switch diamond; S2-S3 shortcut physically down at baseline, enabled for candidate and recovery",
              "topology_profile": args.topology_profile,
              "topology_profile_parameters": TOPOLOGY_PROFILE_PARAMETERS[args.topology_profile],
              "topology_structure": {"hosts": 6, "switches": 4, "route_ports_fixed": True,
                                     "arbitrary_editor_mutation": False},
              "demand": "synthetic iperf3 TCP plus 5 route probes and 50 per-class scenario probes",
              "selected_method": summarize_method_policy(method_id),
              "method_mode": "default" if method_id is None else method_id,
              "stages": ["failure_recovery", "baseline", "shortcut", "prevention"], "threshold_fraction": THRESHOLD,
              "cost_formula": "(latency_ms/20 + jitter_ms/5 + packet_loss_pct/1)/3; relative stage cost threshold 5%",
              "cost_references": COST_REFERENCES,
              "metric_methods": {"latency_ms": "median successful one-packet ping RTT", "jitter_ms": "median absolute difference for adjacent successful RTT pairs; at least two pairs", "packet_loss_pct": "100 * lost probes / 5"},
              "required_samples": SAMPLES, "max_sample_age_seconds": MAX_AGE,
              "cbdr_batch_max_age_seconds": CBDR_BATCH_MAX_AGE,
              "traffic_classes": class_config,
              "required_scenarios": scenario_plan,
              "required_repetitions_per_scenario": SCENARIO_REPETITIONS,
              "random_seed": random_seed,
              "workload_randomization": "seeded +/-10% offered-rate perturbations by scenario and class; identical seed reproduces configured rates",
              "scenario_workload": {"traffic": "simultaneous DSCP-marked UDP flows using CICIoMT2024 training-derived synthetic rate and packet-size profiles",
                  "dataset_profile_file": dataset_provenance["source_file"],
                  "dataset_profile_version": dataset_provenance["profile_version"],
                  "workload_by_scenario_and_class": scenario_workloads,
                  "heavy_background_rate_policy": "configured bottleneck capacity plus the other classes' nominal training-profile offered rates; the resulting synthetic rate is scaled from the selected training-derived high profile rate",
                  "congestion_bottleneck": {"port": SCENARIO_BOTTLENECK_PORT,
                      "capacity_mbps": SCENARIO_BOTTLENECK_CAPACITY_MBPS,
                      "active_only_in_heavy_background_scenarios": True},
                  "scenario_ping_probe_count": SCENARIO_PING_SAMPLES,
                  "measurement": "per-class median RTT, adjacent RTT jitter, iperf UDP loss and received throughput; OpenFlow port-counter link utilization"},
              "dataset_used": True,
              "dataset_workload": {key: value for key, value in dataset_provenance.items()
                                   if key != "profiles"},
              "traffic_catalog": traffic_catalog,
              "dataset_interpretation": "training-derived aggregate benign traffic profiles shape synthetic scenario offered rates and UDP packet sizes; raw packet replay and healthcare labels are not inferred",
              "acceptance": "if harmful, verify the selected baseline route using complete follow-up telemetry, the recorded controller decision, and matching baseline OpenFlow actions; retain measured follow-up cost separately. For neutral or beneficial decisions, verify the actual route matches the selected mode"}
    config["cbdr_policy"] = json.loads((ROOT / "config" / "healthcare_qos.json").read_text(encoding="utf-8"))
    config["traffic_class_measurement_scope"] = (
        "Candidate baseline/shortcut decision probes are aggregate route measurements; "
        "they do not establish per-class objective satisfaction.")
    save_json(out / "config.json", config)
    routes = json.loads((ROOT / "sdn" / "routes.json").read_text(encoding="utf-8"))
    os.environ["MEDROUTE_LOG"] = str(out / "controller.jsonl")
    ryu = None
    net = None
    summary = {"live_experiment": "infrastructure_failure", "live_prevention_verified": False}
    details = {}
    try:
        from mininet.net import Mininet
        from mininet.node import RemoteController
        from mininet.link import TCLink
        sys.path.insert(0, str(ROOT / "sdn"))
        from topology import MedRouteTopo
        ryu_manager = Path(sys.executable).with_name("ryu-manager")
        if not ryu_manager.is_file():
            raise RuntimeError("ryu-manager is not installed beside the active Python interpreter: {}".format(sys.executable))
        with (out / "ryu.stdout.log").open("w", encoding="utf-8") as log:
            ryu = subprocess.Popen([str(ryu_manager), "--ofp-tcp-listen-port", "6653",
                "--wsapi-port", "8080", "sdn/controller.py"], cwd=ROOT,
                stdout=log, stderr=subprocess.STDOUT, env=os.environ.copy())
            wait_controller(ryu)
            net = Mininet(topo=MedRouteTopo(profile=args.topology_profile), controller=None, link=TCLink,
                          autoSetMacs=True, build=True)
            net.addController("c0", controller=RemoteController, ip="127.0.0.1", port=6653)
            net.start()
            wait_switches()
            shortcut_link = next(link for link in net.links if
                {link.intf1.node.name, link.intf2.node.name} == {"s2", "s3"})
            failed_link = next(link for link in net.links if
                {link.intf1.node.name, link.intf2.node.name} == {"s1", "s2"})
            set_shortcut_link(shortcut_link, False)
            h1, h2 = net.get("h1", "h2")
            h1.setARP("10.0.0.2", "00:00:00:00:00:02")
            h2.setARP("10.0.0.1", "00:00:00:00:00:01")
            connectivity_probe = h1.cmd("ping -n -c 3 -W 2 10.0.0.2")
            (out / "baseline-connectivity.txt").write_text(
                "=== h1 ping h2 ===\n" + connectivity_probe +
                "\n=== h1 routes ===\n" + h1.cmd("ip route") +
                "\n=== h1 neighbors ===\n" + h1.cmd("ip neigh") +
                "\n=== baseline flows ===\n" + "\n".join(
                    "### {}\n{}".format(switch, subprocess.run(
                        ["ovs-ofctl", "-O", "OpenFlow13", "dump-flows", switch],
                        cwd=ROOT, capture_output=True, text=True, timeout=8).stdout)
                    for switch in ("s1", "s2", "s4")),
                encoding="utf-8")
            received_match = re.search(r"(\d+) received", connectivity_probe)
            if not received_match or int(received_match.group(1)) < 1:
                raise RuntimeError("baseline connectivity probe failed; see baseline-connectivity.txt")
            if selected_method is not None:
                qos_verified = restore_method_qos_state(
                    selected_method.method_id,
                    set_qos_fn=set_qos_enabled,
                    read_qos_fn=lambda: request_json(timeout=1, endpoint=QOS_API).get("qos_enabled"))
                if not qos_verified:
                    raise RuntimeError("selected method {} did not restore the required QoS state".format(selected_method.method_id))
                if args.ablation == "disable_priority_handling":
                    set_qos_enabled(False)
                    observed_qos = request_json(timeout=1, endpoint=QOS_API).get("qos_enabled")
                    if observed_qos is not False:
                        raise RuntimeError("priority-handling ablation did not confirm QoS disabled")
                set_mode(selected_method.initial_route, "selected method {}".format(selected_method.method_id))
                verify_flows("method_{}".format(selected_method.method_id.lower()),
                             selected_method.initial_route, out, routes, class_config)
            if args.skip_failure_recovery:
                recovery = {"enabled": False, "complete": None,
                            "reason": "controlled failure check disabled by command line"}
            else:
                recovery = {"enabled": True, **run_link_failure_recovery(
                    net, failed_link, shortcut_link, out, routes, class_config,
                    method_qos_enabled=(selected_method.qos_enabled if selected_method is not None else True))}
            baseline = sample_stage(net, "baseline", "baseline", out, routes, class_config)
            congestion_repetitions = []
            if selected_method is None:
                set_shortcut_link(shortcut_link, True)
                candidate = sample_stage(net, "shortcut", "shortcut", out, routes, class_config)
                paired_baseline = measure_route_condition(net, "baseline", shortcut_link,
                                                           out, routes, class_config)
                paired_candidate = measure_route_condition(net, "shortcut", shortcut_link,
                                                           out, routes, class_config)
                for record, paired in ((baseline, paired_baseline), (candidate, paired_candidate)):
                    record["stage_samples"] = record["samples"]
                    record["stage_metrics"] = record["metrics"]
                    record["decision_probe"] = paired
                    record["samples"] = paired["samples"]
                    record["sample_count"] = len(paired["samples"])
                    record["valid_count"] = paired["valid_count"]
                    record["metrics"] = paired["metrics"]
            else:
                candidate = None
                paired_baseline = {"complete": True, "samples": baseline["samples"], "valid_count": baseline["valid_count"], "metrics": baseline["metrics"]}
                baseline["stage_samples"] = baseline["samples"]
                baseline["stage_metrics"] = baseline["metrics"]
                baseline["decision_probe"] = paired_baseline
                baseline["samples"] = paired_baseline["samples"]
                baseline["sample_count"] = len(paired_baseline["samples"])
                baseline["valid_count"] = paired_baseline["valid_count"]
                baseline["metrics"] = paired_baseline["metrics"]
            if selected_method is None:
                decision = classify(baseline, candidate)
                if not decision.get("reason"):
                    decision["reason"] = ("shortcut cost exceeded baseline by more than {:.0%} threshold".format(THRESHOLD)
                        if decision["verdict"] == "harmful" else
                        "shortcut cost was more than {:.0%} below baseline".format(THRESHOLD)
                        if decision["verdict"] == "beneficial" else
                        "shortcut cost was within the {:.0%} neutral band".format(THRESHOLD))
                prevention_mode = decision["mode"]
                set_mode(prevention_mode, "measurement decision: " + decision["verdict"])
                prevention = sample_stage(net, "prevention", prevention_mode, out, routes, class_config)
                records = {"baseline": baseline, "shortcut": candidate, "prevention": prevention}
                save_json(out / "measurements.json", records)
                verified = all(records[s]["flow_evidence"]["verified"] for s in records)
                complete = all(records[s]["metrics"] and records[s]["metrics"]["complete"] for s in records)
                passed = False
                if not complete:
                    live_status = "inconclusive"
                elif decision["verdict"] == "harmful":
                    passed = False
                    live_status = "prevention_failed"
                else:
                    passed = decision["verdict"] != "inconclusive" and prevention_mode == decision["mode"] and verified
                    live_status = "shortcut_not_harmful_under_test" if passed else "inconclusive"
                decision_record = {"repetition": 1, "verdict": decision["verdict"], "selected_route": prevention_mode,
                    "reason": decision["reason"], "threshold_fraction": THRESHOLD,
                    "structured_evaluation": decision.get("structured_evaluation"),
                    "metrics_used": {"baseline": baseline["metrics"], "shortcut": candidate["metrics"]},
                    "sample_timestamps": {
                        "baseline": [sample["timestamp"] for sample in baseline["samples"]],
                        "shortcut": [sample["timestamp"] for sample in candidate["samples"]]},
                    "prevention_verified": harmful_shortcut_prevented(
                        decision["verdict"], prevention_mode,
                        stage_measurement_complete(prevention), verified, True),
                    "route_selection_verified": bool(prevention_mode == decision["mode"] and verified),
                    "flows_verified": verified,
                    "prevention_metrics": prevention["metrics"]}
                try:
                    controller_decision = request_json("POST", decision_record, timeout=3,
                                                       endpoint=DECISION_API)
                    decision_record["controller_recorded"] = bool(controller_decision.get("recorded"))
                except Exception as exc:
                    decision_record["controller_recorded"] = False
                    decision_record["controller_error"] = type(exc).__name__ + ": " + str(exc)
                decision_record["prevention_verified"] = bool(
                    decision_record["prevention_verified"] and
                    decision_record["controller_recorded"])
                if decision["verdict"] == "harmful":
                    passed = decision_record["prevention_verified"]
                    live_status = "harmful_shortcut_prevented" if passed else "prevention_failed"
                if not decision_record["controller_recorded"]:
                    passed = False
                    live_status = "decision_recording_failed"
                braess_repetitions = [{"repetition": 1, "baseline": baseline,
                    "shortcut": candidate, "prevention": prevention, "decision": decision_record,
                    "complete": complete,
                    "prevention_verified": decision_record["prevention_verified"]}]
                for repetition in range(2, SCENARIO_REPETITIONS + 1):
                    braess_repetitions.append(run_braess_repetition(
                        net, repetition, shortcut_link, out, routes, class_config))
            elif selected_method.method_id == "M3":
                for repetition in range(1, SCENARIO_REPETITIONS + 1):
                    congestion_repetitions.append(run_congestion_route_repetition(
                        net, repetition, shortcut_link, out, routes, class_config))
                last_congestion = congestion_repetitions[-1]
                decision = last_congestion["selection"]
                decision_record = last_congestion["decision"]
                prevention_mode = last_congestion["selected_route"]
                prevention = {"metrics": next((item.get("metrics") for item in
                    last_congestion["route_measurements"]
                    if item.get("mode") == prevention_mode), None),
                    "complete": last_congestion["complete"], "samples": []}
                candidate = next((item for item in last_congestion["route_measurements"]
                                  if item.get("mode") == "shortcut"), None)
                records = {"baseline": baseline, "shortcut": candidate,
                           "prevention": prevention}
                save_json(out / "measurements.json", records)
                verified = all(item["flow_evidence"].get("verified")
                               for item in last_congestion["route_measurements"])
                complete = all(item.get("complete") for item in congestion_repetitions)
                passed = complete and verified
                live_status = "congestion_route_selected" if passed else "inconclusive"
                braess_repetitions = []
            elif selected_method.method_id == "M4":
                cbdr_repetitions = []
                for repetition in range(1, SCENARIO_REPETITIONS + 1):
                    cbdr_repetitions.append(run_cbdr_repetition(
                        net, repetition, shortcut_link, out, routes, class_config,
                        traffic_catalog, qos_enabled=(selected_method.qos_enabled and
                            args.ablation != "disable_priority_handling"),
                        random_seed=random_seed, ablation=args.ablation))
                last_cbdr = cbdr_repetitions[-1]
                decision = last_cbdr.get("evaluation", {})
                decision_record = last_cbdr.get("decision", {})
                prevention_mode = last_cbdr.get("decision", {}).get("selected_route", "baseline")
                prevention = {"metrics": None, "complete": last_cbdr.get("complete", False),
                              "samples": []}
                candidate = {"complete": last_cbdr.get("complete", False),
                             "metrics": {"complete": last_cbdr.get("complete", False)},
                             "profiles": last_cbdr.get("candidate_profiles", [])}
                records = {"baseline": baseline, "shortcut": candidate,
                           "prevention": prevention}
                save_json(out / "measurements.json", records)
                verified = all(row.get("decision", {}).get("flows_verified")
                               for row in cbdr_repetitions)
                complete = all(row.get("complete") for row in cbdr_repetitions)
                passed = complete and verified
                live_status = "cbdr_route_selected" if passed else "inconclusive"
                braess_repetitions = []
            else:
                braess_repetitions = []
                decision = {"verdict": "not_run", "mode": selected_method.initial_route,
                            "reason": "Braess shortcut evaluation disabled for method {}".format(selected_method.method_id),
                            "guard_status": "not_run", "guard_verified": False, "guard_passed": False}
                decision_record = {"repetition": 0, "verdict": "not_run", "selected_route": selected_method.initial_route,
                                    "controller_recorded": False, "route_selection_verified": False,
                                    "prevention_verified": False, "reason": decision["reason"],
                                    "guard_status": "not_run", "guard_verified": False, "guard_passed": False}
                prevention = {"metrics": None, "complete": False, "samples": []}
                records = {"baseline": baseline, "shortcut": None, "prevention": prevention}
                save_json(out / "measurements.json", records)
                verified = all((record is not None and record.get("flow_evidence", {}).get("verified"))
                               for record in (baseline,))
                complete = bool(baseline.get("metrics") and baseline["metrics"].get("complete"))
                passed = bool(complete and verified)
                live_status = "method_policy_only" if passed else "inconclusive"
            scenario_repetitions = {}
            scenario_statistics = {}
            scenario_validation = True
            scenario_validation_errors = []
            for scenario, spec in scenario_plan.items():
                bottleneck_evidence = configure_scenario_bottleneck(
                    spec.get("bottleneck", spec["heavy_background"]), class_config)
                rows = []
                scenario_route = (prevention_mode if selected_method is not None and
                    selected_method.method_id in ("M3", "M4") else "baseline")
                for repetition in range(1, SCENARIO_REPETITIONS + 1):
                    rows.append(sample_scenario_traffic(net, scenario, repetition,
                        (False if args.ablation == "disable_priority_handling" else spec["qos_enabled"]), spec["heavy_background"], out, routes,
                        class_config, bottleneck_evidence,
                        scenario_workloads[scenario],
                        bottleneck_congested=spec.get("bottleneck", spec["heavy_background"]),
                        route_mode=scenario_route, shortcut_link=shortcut_link))
                scenario_repetitions[scenario] = rows
                saved_rows = [json.loads((out / "scenario_{}_r{}.json".format(scenario, i)).read_text(encoding="utf-8"))
                              for i in range(1, SCENARIO_REPETITIONS + 1)]
                scenario_statistics[scenario] = summarize_scenario_repetitions(saved_rows, class_config)
                for row in rows:
                    flow_evidence = row.get("flow_evidence", {})
                    if not row.get("complete"):
                        usage = flow_evidence.get("class_traffic_usage", {})
                        flow_failure_count = 0
                        for name, detail in usage.get("classes", {}).items():
                            if not detail.get("complete"):
                                flow_failure_count += 1
                                scenario_validation_errors.append(
                                    "{} r{} {} flow did not hit expected queue: packets={}, expected={}, observed={}".format(
                                        scenario, row.get("repetition"), name,
                                        detail.get("packets"), detail.get("expected_queue_id"),
                                        detail.get("observed_queue_ids")))
                        if not usage or flow_failure_count == 0:
                            scenario_validation_errors.append(
                                "{} r{} incomplete telemetry or flow evidence".format(
                                    scenario, row.get("repetition")))
                    if (not flow_evidence.get("verified") or
                            flow_evidence.get("qos_enabled") != spec["qos_enabled"]):
                        scenario_validation_errors.append(
                            "{} r{} route/QoS configuration evidence mismatch".format(
                                scenario, row.get("repetition")))
                scenario_validation = scenario_validation and all(row["complete"] and
                    row["flow_evidence"]["verified"] and
                    row["flow_evidence"]["qos_enabled"] == spec["qos_enabled"] for row in rows)
            configure_scenario_bottleneck(False, class_config)
            if selected_method is not None and selected_method.method_id == "M1":
                profile_matrix = []
            else:
                profile_matrix = run_catalog_profile_matrix(
                    net, traffic_catalog, class_config, out, routes,
                    method_qos_enabled=(selected_method.qos_enabled if selected_method is not None else True))
            catalog_matrix_summary, catalog_matrix_errors = catalog_matrix_validation(
                selected_method.method_id if selected_method is not None else None, profile_matrix)
            combined_validation_errors = combine_validation_errors(
                scenario_validation_errors, catalog_matrix_errors)
            if combined_validation_errors != scenario_validation_errors:
                scenario_validation = False
            scenario_validation_errors = combined_validation_errors
            # Restore the ordinary route port rate before final route verification and cleanup.
            configure_scenario_bottleneck(False, class_config)
            if selected_method is not None:
                qos_restored = restore_method_qos_state(
                    selected_method.method_id,
                    set_qos_fn=set_qos_enabled,
                    read_qos_fn=lambda: request_json(timeout=1, endpoint=QOS_API).get("qos_enabled"))
                if not qos_restored:
                    scenario_validation = False
                    scenario_validation_errors.append(
                        "method {} QoS state was not restored before final verification".format(selected_method.method_id))
            for trial in braess_repetitions:
                decision_entry = trial["decision"]
                if trial["repetition"] == 1 and not decision_entry.get("controller_recorded"):
                    scenario_validation = False
                    scenario_validation_errors.append(
                        "Braess r1 decision was not recorded by controller")
                    continue
                if trial["repetition"] > 1 and not decision_entry.get("controller_recorded"):
                    scenario_validation = False
                    scenario_validation_errors.append(
                        "Braess r{} decision was not recorded by controller".format(
                            trial["repetition"]))
                if (decision_entry.get("verdict") == "harmful" and
                        not decision_entry.get("prevention_verified")):
                    scenario_validation = False
                    scenario_validation_errors.append(
                        "Braess r{} harmful shortcut did not meet prevention verification".format(
                            trial["repetition"]))
                if not trial.get("complete") or not decision_entry.get("route_selection_verified"):
                    scenario_validation = False
                    scenario_validation_errors.append(
                        "Braess r{} has incomplete metrics or route selection evidence".format(
                            trial["repetition"]))
            braess_validation = braess_validation_result(
                selected_method.method_id if selected_method is not None else None,
                braess_repetitions)
            if selected_method is None:
                scenario_validation = scenario_validation and braess_validation["passed"]
            elif selected_method.method_id == "M3":
                scenario_validation = scenario_validation and all(
                    item.get("complete") and item.get("decision", {}).get("controller_recorded") and
                    item.get("route_selection_verified") for item in congestion_repetitions)
                braess_validation = {"status": "not_run", "passed": False,
                                     "not_applicable": True}
            else:
                braess_validation["status"] = "not_run"
                braess_validation["passed"] = False
                braess_validation["not_applicable"] = True
            braess_statistics = summarize_braess_repetitions(braess_repetitions)
            repeated_decision_summary = summarize_repeated_decisions(braess_repetitions)
            candidate_evaluations = []
            if isinstance(decision_record, dict):
                candidate_evaluations.append(
                    decision_record.get("structured_evaluation") or
                    decision_record.get("evaluation") or {})
            telemetry_completeness = summarize_telemetry_completeness(
                records.values(), scenario_statistics, scenario_repetitions,
                candidate_evaluations)
            scenario_result = {"required_repetitions": SCENARIO_REPETITIONS,
                "scenarios": scenario_repetitions,
                "statistics_from_saved_measurements": scenario_statistics,
                "braess_shortcut_repetitions": braess_repetitions,
                "congestion_route_repetitions": congestion_repetitions,
                "braess_statistics": braess_statistics,
                "braess_validation": braess_validation,
                "validation_errors": scenario_validation_errors,
                "validation_passed": bool(scenario_validation)}
            save_json(out / "scenario_results.json", scenario_result)
            if selected_method is None:
                selected_final = braess_repetitions[-1]["decision"]["selected_route"]
                set_shortcut_link(shortcut_link, selected_final == "shortcut")
                set_mode(selected_final, "restore final repeated Braess decision")
                final_route_evidence = verify_flows("final_selected", selected_final,
                                                    out, routes, class_config)
                if not scenario_validation:
                    live_status = "scenario_validation_failed"
                elif not repeated_decision_summary["passed"]:
                    live_status = repeated_decision_summary["live_experiment"]
                else:
                    live_status = repeated_decision_summary["live_experiment"]
                passed = bool(repeated_decision_summary["passed"] and scenario_validation)
                decisions = {"shortcut_decision": decision, "route_decision": decision_record,
                             "prevention_mode": prevention_mode,
                             "baseline_cost": baseline["metrics"]["cost"] if baseline["metrics"] else None,
                             "shortcut_cost": candidate["metrics"]["cost"] if candidate and candidate["metrics"] else None,
                             "prevention_cost": prevention["metrics"]["cost"] if prevention["metrics"] else None}
                aggregate_verdict = repeated_decision_summary["aggregate_verdict"]
                summary = {"live_experiment": live_status,
                            "live_prevention_verified": bool(
                                repeated_decision_summary["harmful_candidate_count"] > 0 and
                                repeated_decision_summary["harmful_candidate_count"] ==
                                repeated_decision_summary["prevention_verified_count"] and
                                repeated_decision_summary["passed"]),
                            "candidate_decision_aggregate": repeated_decision_summary,
                           "failure_recovery": recovery,
                           "dataset_used": True,
                           "dataset_profile_version": dataset_provenance["profile_version"],
                           "dataset_profile_sha256": dataset_provenance["source_sha256"],
                           "shortcut_verdict": aggregate_verdict,
                           "shortcut_verdict_counts": repeated_decision_summary["verdict_counts"],
                           "all_flow_rules_verified": verified,
                           "all_telemetry_complete": telemetry_completeness["all_telemetry_complete"],
                           "required_telemetry_complete": telemetry_completeness["required_telemetry_complete"],
                           "optional_telemetry": telemetry_completeness["optional_telemetry"],
                           "optional_telemetry_complete": telemetry_completeness["optional_telemetry_complete"],
                           "baseline_metrics": baseline["metrics"], "shortcut_metrics": candidate["metrics"] if candidate else None,
                           "prevention_metrics": prevention["metrics"],
                           "route_decision": decision_record,
                           "decision_metrics_used": decision_record.get("metrics_used"),
                           "selected_route": selected_final,
                           "prevention_mode": prevention_mode,
                           "scenario_repetitions": {name: len(rows) for name, rows in scenario_repetitions.items()},
                           "catalog_profile_matrix": catalog_matrix_summary,
                           "braess_validation": braess_validation,
                           "braess_repetitions": len(braess_repetitions),
                           "scenario_validation_passed": bool(scenario_validation),
                           "scenario_validation_errors": scenario_validation_errors,
                           "scenario_statistics_file": "scenario_results.json",
                           "braess_prevention_verified_repetitions": braess_statistics["prevention_verified_count"],
                           "final_repeated_route": selected_final,
                           "final_route_verified": final_route_evidence["verified"],
                           "controller_metrics_published": all(
                               bool(records[key].get("controller_metrics", {}).get("complete"))
                               for key in records if isinstance(records.get(key), dict)),
                           "per_class_metrics_complete": all(
                               all(bool(item.get("complete")) for item in records[key]["per_class_metrics"].values())
                               for key in records if isinstance(records.get(key), dict) and isinstance(records[key].get("per_class_metrics"), dict)),
                           "link_utilization_complete": all(
                               bool(records[key].get("link_utilization", {}).get("complete"))
                               for key in records if isinstance(records.get(key), dict) and isinstance(records[key].get("link_utilization"), dict))}
            elif selected_method.method_id == "M3":
                selected_final = congestion_repetitions[-1]["selected_route"]
                set_shortcut_link(shortcut_link, selected_final == "shortcut")
                set_mode(selected_final, "restore final M3 congestion selection")
                final_route_evidence = verify_flows("final_selected", selected_final,
                                                    out, routes, class_config)
                passed = bool(scenario_validation and all(
                    row.get("complete") and row.get("route_selection_verified")
                    for row in congestion_repetitions) and final_route_evidence["verified"])
                live_status = "congestion_route_selected" if passed else "scenario_validation_failed"
                decisions = {"congestion_route_repetitions": congestion_repetitions,
                             "selected_route": selected_final}
                summary = {"live_experiment": live_status,
                           "live_prevention_verified": False,
                           "method_policy": summarize_method_policy("M3"),
                           "failure_recovery": recovery,
                           "congestion_route_repetitions": len(congestion_repetitions),
                           "congestion_scores_pct": [row["selection"]["scores_pct"]
                               for row in congestion_repetitions],
                           "route_decisions": [row["decision"] for row in congestion_repetitions],
                           "all_flow_rules_verified": verified,
                           "all_telemetry_complete": telemetry_completeness["all_telemetry_complete"],
                           "required_telemetry_complete": telemetry_completeness["required_telemetry_complete"],
                           "optional_telemetry": telemetry_completeness["optional_telemetry"],
                           "optional_telemetry_complete": telemetry_completeness["optional_telemetry_complete"],
                           "selected_route": selected_final,
                           "final_repeated_route": selected_final,
                           "final_route_verified": final_route_evidence["verified"],
                           "scenario_repetitions": {name: len(rows) for name, rows in scenario_repetitions.items()},
                           "catalog_profile_matrix": catalog_matrix_summary,
                           "braess_validation": braess_validation,
                           "braess_repetitions": 0,
                           "scenario_validation_passed": bool(scenario_validation),
                           "scenario_validation_errors": scenario_validation_errors,
                           "scenario_statistics_file": "scenario_results.json",
                           "controller_metrics_published": bool(isinstance(records.get("baseline"), dict) and records["baseline"].get("controller_metrics", {}).get("complete")),
                           "per_class_metrics_complete": bool(isinstance(records.get("baseline"), dict) and all(bool(item.get("complete")) for item in records["baseline"].get("per_class_metrics", {}).values())),
                           "link_utilization_complete": bool(isinstance(records.get("baseline"), dict) and records["baseline"].get("link_utilization", {}).get("complete"))}
            elif selected_method.method_id == "M4":
                # M4 uses CBDR repetitions, not the separate Braess repetition list.
                repeated_decision_summary = summarize_repeated_decisions(cbdr_repetitions)
                selected_final = cbdr_repetitions[-1].get(
                    "decision", {}).get("selected_route", "baseline")
                set_shortcut_link(shortcut_link, selected_final == "shortcut")
                set_mode(selected_final, "restore final M4 CBDR decision")
                final_route_evidence = verify_flows(
                    "final_selected", selected_final, out, routes, class_config)

                if not scenario_validation:
                    live_status = "scenario_validation_failed"
                else:
                    live_status = repeated_decision_summary["live_experiment"]

                prevention_verified = bool(
                    repeated_decision_summary["harmful_candidate_count"] > 0 and
                    repeated_decision_summary["harmful_candidate_count"] ==
                    repeated_decision_summary["prevention_verified_count"] and
                    repeated_decision_summary["passed"] and
                    final_route_evidence.get("verified"))

                decisions = {
                    "route_decisions": [row.get("decision", {}) for row in cbdr_repetitions],
                    "candidate_decision_aggregate": repeated_decision_summary,
                    "selected_route": selected_final,
                }
                summary = {
                    "live_experiment": live_status,
                    "live_prevention_verified": prevention_verified,
                    "candidate_decision_aggregate": repeated_decision_summary,
                    "shortcut_verdict": repeated_decision_summary["aggregate_verdict"],
                    "shortcut_verdict_counts": repeated_decision_summary["verdict_counts"],
                    "method_policy": summarize_method_policy("M4"),
                    "failure_recovery": recovery,
                    "dataset_used": True,
                    "dataset_profile_version": dataset_provenance["profile_version"],
                    "dataset_profile_sha256": dataset_provenance["source_sha256"],
                    "all_flow_rules_verified": verified,
                    "all_telemetry_complete": telemetry_completeness["all_telemetry_complete"],
                    "required_telemetry_complete": telemetry_completeness["required_telemetry_complete"],
                    "optional_telemetry": telemetry_completeness["optional_telemetry"],
                    "optional_telemetry_complete": telemetry_completeness["optional_telemetry_complete"],
                    "baseline_metrics": baseline.get("metrics"),
                    "shortcut_metrics": candidate.get("metrics") if candidate else None,
                    "prevention_metrics": None,
                    "route_decision": decision_record,
                    "decision_metrics_used": decision_record.get("metrics_used")
                        if isinstance(decision_record, dict) else None,
                    "selected_route": selected_final,
                    "prevention_mode": prevention_mode,
                    "cbdr_repetitions": len(cbdr_repetitions),
                    "cbdr_prevention_verified_repetitions":
                        repeated_decision_summary["prevention_verified_count"],
                    "scenario_repetitions": {
                        name: len(rows) for name, rows in scenario_repetitions.items()},
                    "catalog_profile_matrix": catalog_matrix_summary,
                    "braess_validation": braess_validation,
                    "braess_repetitions": 0,
                    "scenario_validation_passed": bool(scenario_validation),
                    "scenario_validation_errors": scenario_validation_errors,
                    "scenario_statistics_file": "scenario_results.json",
                    "final_repeated_route": selected_final,
                    "final_route_verified": final_route_evidence.get("verified", False),
                    "controller_metrics_published": bool(
                        isinstance(records.get("baseline"), dict) and
                        records["baseline"].get("controller_metrics", {}).get("complete")),
                    "per_class_metrics_complete": bool(
                        isinstance(records.get("baseline"), dict) and
                        all(item.get("complete") for item in
                            records["baseline"].get("per_class_metrics", {}).values())),
                    "link_utilization_complete": bool(
                        isinstance(records.get("baseline"), dict) and
                        records["baseline"].get("link_utilization", {}).get("complete")),
                }
            else:
                selected_final = selected_method.initial_route
                set_shortcut_link(shortcut_link, False)
                set_mode(selected_final, "restore method {} baseline route".format(selected_method.method_id))
                final_route_evidence = verify_flows("final_selected", selected_final,
                                                    out, routes, class_config)
                if not scenario_validation:
                    live_status = "scenario_validation_failed"
                decisions = {"shortcut_decision": decision, "route_decision": decision_record,
                             "prevention_mode": selected_final,
                             "baseline_cost": baseline["metrics"]["cost"] if baseline["metrics"] else None,
                             "shortcut_cost": None,
                             "prevention_cost": None}
                summary = {"live_experiment": live_status,
                           "live_prevention_verified": False,
                           "failure_recovery": recovery,
                           "dataset_used": True,
                           "dataset_profile_version": dataset_provenance["profile_version"],
                           "dataset_profile_sha256": dataset_provenance["source_sha256"],
                           "shortcut_verdict": "not_run",
                           "method_policy": summarize_method_policy(selected_method.method_id),
                           "all_flow_rules_verified": verified,
                           "all_telemetry_complete": telemetry_completeness["all_telemetry_complete"],
                           "required_telemetry_complete": telemetry_completeness["required_telemetry_complete"],
                           "optional_telemetry": telemetry_completeness["optional_telemetry"],
                           "optional_telemetry_complete": telemetry_completeness["optional_telemetry_complete"],
                           "baseline_metrics": baseline["metrics"],
                           "shortcut_metrics": None,
                           "prevention_metrics": None,
                           "route_decision": decision_record,
                           "decision_metrics_used": decision_record.get("metrics_used") if isinstance(decision_record, dict) else None,
                           "selected_route": selected_final,
                           "scenario_repetitions": {name: len(rows) for name, rows in scenario_repetitions.items()},
                           "catalog_profile_matrix": catalog_matrix_summary,
                           "braess_validation": braess_validation,
                           "braess_repetitions": 0,
                           "scenario_validation_passed": bool(scenario_validation),
                           "scenario_validation_errors": scenario_validation_errors,
                           "scenario_statistics_file": "scenario_results.json",
                           "braess_prevention_verified_repetitions": 0,
                           "final_repeated_route": selected_final,
                           "final_route_verified": final_route_evidence["verified"],
                           "controller_metrics_published": bool(isinstance(records.get("baseline"), dict) and records["baseline"].get("controller_metrics", {}).get("complete")),
                           "per_class_metrics_complete": bool(isinstance(records.get("baseline"), dict) and all(bool(item.get("complete")) for item in records["baseline"].get("per_class_metrics", {}).values())),
                           "link_utilization_complete": bool(isinstance(records.get("baseline"), dict) and records["baseline"].get("link_utilization", {}).get("complete"))}
            if selected_method is not None:
                final_qos_verified = restore_method_qos_state(
                    selected_method.method_id,
                    set_qos_fn=set_qos_enabled,
                    read_qos_fn=lambda: request_json(timeout=1, endpoint=QOS_API).get("qos_enabled"))
                summary["final_qos_enabled"] = selected_method.qos_enabled
                summary["final_qos_verified"] = bool(final_qos_verified)
                if not final_qos_verified:
                    summary["live_experiment"] = "policy_restore_failed"
            save_json(out / "decisions.json", decisions)
            (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
            try:
                subprocess.run([sys.executable, str(ROOT / "scripts" / "build_evidence_db.py"),
                                str(out)], check=True, cwd=ROOT,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                summary["evidence_database"] = "evidence.sqlite"
                (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n",
                                                  encoding="utf-8")
            except (OSError, subprocess.CalledProcessError) as exc:
                summary["evidence_database"] = None
                summary["evidence_database_error"] = str(exc)
                (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n",
                                                  encoding="utf-8")
            if selected_method is None:
                return 0 if passed and scenario_validation else 2
            return compute_exit_code(passed, scenario_validation,
                                    selected_method=selected_method.method_id,
                                    final_qos_verified=summary.get("final_qos_verified"))
    except Exception as exc:
        summary.update({"error": type(exc).__name__ + ": " + str(exc), "live_prevention_verified": False})
        details["traceback"] = traceback.format_exc()
        details["host_links_at_failure"] = diagnostic_command(["ip", "-o", "link", "show"])
        details["ovs_bridges_at_failure"] = diagnostic_command(["ovs-vsctl", "show"])
        if net is not None:
            try:
                details["mininet_interfaces"] = [
                    {"intf1": link.intf1.name, "intf2": link.intf2.name}
                    for link in net.links]
            except Exception as diagnostic_error:
                details["mininet_interfaces_error"] = (
                    type(diagnostic_error).__name__ + ": " + str(diagnostic_error))
        (out / "error.txt").write_text(json.dumps(details, indent=2) + "\n", encoding="utf-8")
        (out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
        return 2
    finally:
        if net is not None:
            try:
                net.stop()
            except Exception as exc:
                (out / "cleanup_error.txt").write_text(str(exc), encoding="utf-8")
        if ryu is not None and ryu.poll() is None:
            ryu.terminate()
            try:
                ryu.wait(timeout=5)
            except subprocess.TimeoutExpired:
                ryu.kill()
                ryu.wait()
        try:
            write_manifest(out, started_at=run_started_at)
        except Exception as manifest_error:
            try:
                (out / "manifest_error.txt").write_text(
                    type(manifest_error).__name__ + ": " + str(manifest_error),
                    encoding="utf-8")
            except OSError:
                pass


if __name__ == "__main__":
    raise SystemExit(main())
