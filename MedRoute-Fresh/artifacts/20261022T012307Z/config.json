  "dataset_used": false,
  "demand": "synthetic iperf3 TCP plus 5 route probes and 50 per-class scenario probes",
  "max_sample_age_seconds": 30.0,
  "metric_methods": {
    "jitter_ms": "median absolute difference for adjacent successful RTT pairs; at least two pairs",
    "latency_ms": "median successful one-packet ping RTT",
    "packet_loss_pct": "100 * lost probes / 5"
  },
  "required_repetitions_per_scenario": 3,
  "required_samples": 5,
