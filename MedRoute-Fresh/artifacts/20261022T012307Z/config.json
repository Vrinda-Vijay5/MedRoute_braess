    "non_congested_rate_mbps_per_class": 2,
    "scenario_ping_probe_count": 100,
    "traffic": "simultaneous UDP flows on each configured class service port, DSCP-marked"
  },
  "stages": [
    "baseline",
    "shortcut",
    "prevention"
  ],
  "threshold_fraction": 0.05,
